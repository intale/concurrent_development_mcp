# Copy to .env.production (ignored by Git). Do not commit real credentials.
# Set all three secrets before deploying. Generate SECRET_KEY_BASE with bin/rails secret.
POSTGRES_USER=coordinator
POSTGRES_PASSWORD=
SECRET_KEY_BASE=
GRAFANA_ADMIN_PASSWORD=

# Relative paths resolve from the project root. Keep this directory across deployments.
PG_HOST_DATA_DIR=./data

DATABASE_NAME=concurrent_development_mcp_production
PG_EVENTSTORE_DATABASE_NAME=eventstore_production
CACHE_DATABASE_NAME=concurrent_development_mcp_production_cache
QUEUE_DATABASE_NAME=concurrent_development_mcp_production_queue

# Pool sizes are per process; PgBouncer bounds physical PostgreSQL connections.
DATABASE_POOL=20
PG_EVENTSTORE_POOL=15
RAILS_MAX_THREADS=3
JOB_CONCURRENCY=1

# Additional MCP Host values: comma-separated hostname or hostname:port, no URLs.
# Unset/blank keeps loopback-only defaults; a bare hostname allows any port.
# bin/deploy-production loads this file into every application service on each deploy.
# MCP_ALLOWED_HOSTS=mcp.example.com,api.example.com:8088

# Optional overrides; ports remain loopback-only.
# POSTGRES_HOST_PORT=6435
# PGBOUNCER_HOST_PORT=6436
# MCP_HOST_PORT=8088
# COORDINATOR_IMAGE=concurrent-development-mcp:production

# Observability: Grafana is the only published backend UI, on loopback.
# The admin password is a first-start bootstrap setting, not password rotation.
GRAFANA_ADMIN_USER=admin
GRAFANA_HOST_PORT=8089
COORDINATOR_OBSERVABILITY_ENABLED=true
OTEL_SERVICE_NAME=concurrent-development-coordinator
COORDINATOR_SERVICE_VERSION=production
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://tempo:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://prometheus:9090/api/v1/otlp/v1/metrics
OTEL_METRIC_EXPORT_INTERVAL=10000
COORDINATOR_OBSERVABILITY_EXPORT_TIMEOUT_MS=3000
COORDINATOR_OBSERVABILITY_TRACE_SAMPLE_RATIO=1.0

# Independent persistent named volumes; earliest Prometheus time/size limit wins.
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
TEMPO_RETENTION=168h

# Copy to .env.development (ignored). Compose uses --env-file; host-run Rails
# does not load it automatically. Export it before starting Rails/subscriptions.
COORDINATOR_OBSERVABILITY_ENABLED=true
OTEL_SERVICE_NAME=concurrent-development-coordinator
COORDINATOR_SERVICE_VERSION=development
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:9090/api/v1/otlp/v1/metrics
OTEL_METRIC_EXPORT_INTERVAL=10000
COORDINATOR_OBSERVABILITY_EXPORT_TIMEOUT_MS=3000
COORDINATOR_OBSERVABILITY_TRACE_SAMPLE_RATIO=1.0

# Local development only. Grafana asks to change its initial admin password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_HOST_PORT=1089
PROMETHEUS_HOST_PORT=9090
TEMPO_OTLP_HOST_PORT=4318
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
TEMPO_RETENTION=168h

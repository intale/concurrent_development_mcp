{
  "name": "concurrent-development-coordinator-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "yarn codegen && yarn typecheck && vite build",
    "codegen": "graphql-codegen --config codegen.ts",
    "dev": "yarn codegen && vite build --watch --mode development",
    "test": "yarn test:compile && node --test .test-dist/test/**/*.test.js",
    "test:compile": "tsc --project tsconfig.test.json --pretty false",
    "typecheck": "tsc --project tsconfig.json --pretty false"
  },
  "dependencies": {
    "@adminlte/react": "0.6.1",
    "@graphql-typed-document-node/core": "3.2.0",
    "@popperjs/core": "2.11.8",
    "@tanstack/react-query": "5.102.8",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "graphql": "16.14.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.3",
    "react_ujs": "3.3.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.3.1",
    "@graphql-codegen/client-preset": "6.1.3",
    "@graphql-codegen/typescript-operations": "6.1.6",
    "@types/node": "26.4.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "packageManager": "yarn@3.5.1+sha512.8cd0e31bd60779ef4ca92b855fb3462c7ec35ce8b345752b7349a68239776417f46d41d79c8047242d9c93b48a1516f64c7444ebe747d9a02bf26868e6fa1f2b"
}

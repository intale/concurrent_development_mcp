#!/usr/bin/env bash
set -euo pipefail

# Temporary, one-time history operator. Deploy the new image/schema first.
cd "$(dirname "$0")/.."
production_migration_action="${1:-run}"
case "$production_migration_action" in
  help|-h|--help)
    echo "Usage: bin/migrate-production [run|status]"
    echo "Deploy with bin/deploy-production first; back up both databases."
    echo "run: initialize historical facts, replay count projections, stop temporary containers."
    echo "status: print related native subscription progress without changing databases."
    echo "Uses PRODUCTION_ENV_FILE and PRODUCTION_COMPOSE_PROJECT; never recreates databases."
    exit 0
    ;;
  run|status) ;;
  *) echo "Usage: bin/migrate-production [run|status]" >&2; exit 64 ;;
esac
if [ "$#" -gt 1 ]; then
  echo "Expected at most one action" >&2
  exit 64
fi

production_migration_env_file="${PRODUCTION_ENV_FILE:-.env.production}"
production_migration_project="${PRODUCTION_COMPOSE_PROJECT:-concurrent-development-mcp-production}"
if [ ! -r "$production_migration_env_file" ]; then
  echo "Create a readable $production_migration_env_file from config/production.env.example first" >&2
  exit 64
fi
if ! [[ "$production_migration_project" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
  echo "PRODUCTION_COMPOSE_PROJECT must be a valid lowercase Compose project name" >&2
  exit 64
fi
export PRODUCTION_ENV_FILE="$production_migration_env_file"
production_migration_compose=(docker compose --env-file "$production_migration_env_file" --project-name "$production_migration_project" -f docker-compose.production.yml)

read -r -d '' production_migration_query <<'RUBY' || true
abort("Migration operator requires production") unless Rails.env.production?
mode = ARGV.fetch(0)
initialization = Coordinator::Processes::Subscriptions::ProjectionInitializationSet
replay = Coordinator::Read::Subscriptions::ProjectionNumbersReplaySet
source_filters = Coordinator::Write::ProjectionInitialization::Definition::ALL.map do |definition|
  [definition.context, definition.stream_name, [definition.source_type]]
end + [
  ["DevelopmentMemory", "DevelopmentArtifactRelation", %w[DevelopmentArtifactRelationDeclared DevelopmentArtifactRelationSuperseded]],
  ["DevelopmentIntegration", "Candidate", ["CandidateSubmitted"]]
]
count_filters = [replay::ARTIFACT_RELATIONS, replay::CHECKPOINTS].map do |definition|
  stream = definition.streams.first
  [stream.context, stream.stream_name, definition.event_types]
end
if mode == "preflight"
  required = %w[20261014125000 20261014131800 20261014134600]
  applied = ActiveRecord::SchemaMigration.new(ActiveRecord::Base.connection_pool).versions
  abort("Run bin/deploy-production first; required Rails migrations are missing") unless (required - applied).empty?
  puts "Production schema ready"
elsif mode.end_with?("-target")
  filters = mode == "initialization-target" ? source_filters : count_filters
  events = filters.filter_map do |context, stream_name, types|
    PgEventstore.client.read(PgEventstore::Stream.all_stream, options: {
      direction: :desc, max_count: 1, filter: {streams: [{context:, stream_name:}], event_types: types}
    }).first
  end
  positions = PgEventstore::EventSubscriptionPositionQueries.new(PgEventstore.connection(:default))
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 60
  loop do
    mapped = events.empty? ? {} : positions.subscription_positions_from_db(events)
    if events.all? { mapped.key?(_1.global_position) }
      puts(positions.max_subscription_position || 0)
      break
    end
    abort("Native position indexing did not catch up; inspect ordinary subscription processes") if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
    sleep 1
  end
else
  sets = mode == "status" ? [initialization::SET_NAME, replay::SET_NAME] : [mode == "initialization" ? initialization::SET_NAME : replay::SET_NAME]
  target = ARGV[1]&.to_i || PgEventstore::EventSubscriptionPositionQueries.new(PgEventstore.connection(:default)).max_subscription_position || 0
  queries = PgEventstore::Subscription.using_connection(:default).subscription_queries
  complete = true
  sets.each do |set|
    rows = queries.find_all(set:)
    expected = set == initialization::SET_NAME ? 7 : 2
    rows.each do |row|
      puts "#{row.fetch(:name)} #{row[:current_position] || 0}/#{target} processed=#{row[:total_processed_events] || 0}"
      abort("#{row.fetch(:name)} failed; inspect its subscription error") if row[:last_error] || %w[dead failed].include?(row[:state])
    end
    complete &&= rows.length == expected && rows.all? { _1[:state] == "running" && (_1[:current_position] || 0) >= target }
    puts "#{set} not started" if rows.empty?
  end
  exit 10 unless complete || mode == "status"
end
RUBY

production_migration_query() {
  "${production_migration_compose[@]}" run --rm --no-deps -T \
    -e COORDINATOR_OBSERVABILITY_ENABLED=false prepare \
    bundle exec rails runner "$production_migration_query" "$@"
}

"${production_migration_compose[@]}" config --quiet
if [ "$production_migration_action" = "status" ]; then
  production_migration_query status
  exit 0
fi

# Share the deployment lock: do not replace the image during migration.
mkdir -p tmp
production_migration_lock="tmp/deploy-${production_migration_project}.lock"
if ! mkdir "$production_migration_lock" 2>/dev/null; then
  echo "Deployment/migration lock exists: $production_migration_lock. Verify the existing run before removing it." >&2
  exit 73
fi
production_migration_owned_container=""
production_migration_cleanup() {
  if [ -n "$production_migration_owned_container" ]; then
    if ! docker stop --time 60 "$production_migration_owned_container" >/dev/null; then
      echo "Could not confirm migration container shutdown; retaining $production_migration_lock for inspection." >&2
      return 1
    fi
  fi
  rmdir "$production_migration_lock"
}
trap production_migration_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

production_migration_query preflight
for production_migration_phase in initialization replay; do
  production_migration_container="${production_migration_project}-projection-${production_migration_phase}"
  if docker container inspect "$production_migration_container" >/dev/null 2>&1; then
    echo "Migration container already exists: $production_migration_container. Inspect/stop that exact run first." >&2
    exit 73
  fi
  production_migration_target="$(production_migration_query "${production_migration_phase}-target")"
  if ! [[ "$production_migration_target" =~ ^[0-9]+$ ]]; then
    echo "Could not obtain the native migration watermark" >&2
    exit 1
  fi
  if [ "$production_migration_phase" = "initialization" ]; then
    production_migration_config="./config/pg_eventstore_projection_initialization.rb"
  else
    production_migration_config="./config/pg_eventstore_projection_numbers_replay.rb"
  fi
  "${production_migration_compose[@]}" run --detach --rm --no-deps -T \
    --name "$production_migration_container" \
    -e COORDINATOR_ALLOW_PROJECTION_MIGRATION=1 \
    -e COORDINATOR_OBSERVABILITY_ROLE=subscriptions prepare \
    bundle exec pg-eventstore subscriptions start -r ./config/environment.rb -r "$production_migration_config"
  production_migration_owned_container="$production_migration_container"
  echo "$production_migration_phase target=$production_migration_target"
  while true; do
    if [ "$(docker container inspect --format '{{.State.Running}}' "$production_migration_container")" != "true" ]; then
      echo "Migration container stopped unexpectedly: $production_migration_container" >&2
      exit 1
    fi
    if production_migration_query "$production_migration_phase" "$production_migration_target"; then
      break
    else
      production_migration_status=$?
      [ "$production_migration_status" -eq 10 ] || exit "$production_migration_status"
    fi
    sleep 10
  done
  docker stop --time 60 "$production_migration_container" >/dev/null
  production_migration_owned_container=""
done
echo "Production historical fact initialization and count replay completed."

#!/usr/bin/env sh

set -eu

parallel_test_processes="${PARALLEL_TEST_PROCESSORS:-15}"

case "$parallel_test_processes" in
  ""|*[!0-9]*|0)
    echo "PARALLEL_TEST_PROCESSORS must be a positive integer" >&2
    exit 64
    ;;
esac

export PARALLEL_TEST_PROCESSORS="$parallel_test_processes"
export PARALLEL_TEST_FIRST_IS_1=true

bundle exec rake "parallel:create[$parallel_test_processes]"
SCHEMA=/dev/null bundle exec rake "parallel:migrate[$parallel_test_processes]"

parallel_test_worker=1
while [ "$parallel_test_worker" -le "$parallel_test_processes" ]; do
  PG_EVENTSTORE_URI="postgresql://postgres:postgres@localhost:5532/eventstore${parallel_test_worker}_test" \
    bundle exec rake pg_eventstore:create pg_eventstore:migrate
  PG_EVENTSTORE_URI="postgresql://postgres:postgres@localhost:5532/eventstore${parallel_test_worker}_migration_target_test" \
    bundle exec rake pg_eventstore:create pg_eventstore:migrate
  parallel_test_worker=$((parallel_test_worker + 1))
done

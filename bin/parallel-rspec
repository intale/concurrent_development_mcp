#!/usr/bin/env sh

set -eu

parallel_rbs_processes="${PARALLEL_TEST_PROCESSORS:-10}"
parallel_rbs_runtime_log="tmp/parallel_runtime_rspec_rbs.log"

case "$parallel_rbs_processes" in
  ""|*[!0-9]*|0)
    echo "PARALLEL_TEST_PROCESSORS must be a positive integer" >&2
    exit 64
    ;;
esac

export PARALLEL_TEST_PROCESSORS="$parallel_rbs_processes"
export PARALLEL_TEST_FIRST_IS_1=true
export PARALLEL_TESTS_EXECUTABLE=bin/rspec

exec bundle exec parallel_rspec \
  --runtime-log "$parallel_rbs_runtime_log" \
  --test-options "--format ParallelTests::RSpec::RuntimeLogger --out $parallel_rbs_runtime_log" \
  "$@"

# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Persistent database data and development-memory recovery material.
/data/
/db/postgresql/
/.mcp-fallback/
/.build/
/.to_review/
/.agents/
/.codex/
/dev_scripts/

# Build the frontend from its lockfile, never from local generated artifacts.
**/node_modules/
**/.yarn/cache/
/ui/.test-dist/
/ui/src/gql/
/public/ui/

# Tests and local tooling are not production runtime sources.
/spec/
/features/
/sig/
/.gem_rbs_collection/

# Ignore all default key files.
/config/master.key
/config/credentials/*.key
**/*.tar.gz

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

module Coordinator
  module Write
    type command_input = Hash[String | Symbol, untyped]
    type event_data = Hash[String | Symbol, untyped]
    type coordination_command = Commands::CreateChangeSet |
                                Commands::CreateWorkItem |
                                Commands::DeclareWorkItemDependency |
                                Commands::ActivateChangeSet |
                                Commands::AcquireWorkItem |
                                Commands::ReserveWriteSet |
                                Commands::ExpandWriteSet |
                                Commands::RenewLeaseSet |
                                Commands::ReleaseLeaseSet
    type write_command = coordination_command | Commands::ExpireResourceLease
    type lifecycle_command = Commands::StartCoordinationTask |
                             Commands::RecordCoordinationTaskOutcome |
                             Commands::CancelCoordinationTask

    interface _CoordinationTaskDecider
      def call: (state: Domain::CoordinationTasks::State, command: lifecycle_command) -> Dry::Monads::Result
    end

    interface _EventStore
      def multiple: [Result] () { () -> Result } -> Result

      def read: (StreamReference, EventReadCriteria) -> Array[PgEventstore::Event]

      def read_grouped: (StreamReference, GroupedEventReadCriteria) -> Array[PgEventstore::Event]

      def read_marked: (StreamReference, MarkedEventReadCriteria) -> Array[PgEventstore::Event]

      def append: (
        StreamReference,
        Array[PgEventstore::Event],
        ?expected_revision: Integer | Symbol | nil
      ) -> Array[PgEventstore::Event]
    end
  end
end

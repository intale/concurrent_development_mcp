module Coordinator
  module Read
    module Interpretations
      type projection_source = {
        source_event: CommandResults::document, source_span: CommandResults::document,
        classifier: CommandResults::document, scope_provenance: CommandResults::document,
        ambiguities: Array[CommandResults::document]
      }

      class ProjectionSourceLoader
        def initialize: (event_store: Write::_EventStore) -> void
        def call: (PgEventstore::Event event) -> projection_source
      end
    end
  end
end

module Coordinator
  module Read
    module Queries
      class CoordContext
        def initialize: (
          ?contract: Contracts::CoordContext,
          ?contexts: Repositories::CoordContexts,
          ?scope_builder: ContextScopeBuilder,
          ?blockers_builder: ContextBlockersBuilder,
          ?next_actions_builder: ContextNextActionsBuilder,
          ?canonical_json: Shared::CanonicalJson
        ) -> void
        # dry-operation prepends #call; runtime RBS wrapping recursively re-enters that wrapper.
        %a{rbs:test:skip}
        def call: (command_input input) -> Dry::Monads::Result

        class AttemptList
          def initialize: (
            ?contract: Contracts::CoordContext::AttemptList,
            ?contexts: Repositories::CoordContexts
          ) -> void
          # dry-operation prepends #call; runtime RBS wrapping recursively re-enters that wrapper.
          %a{rbs:test:skip}
          def call: (command_input input) -> Dry::Monads::Result
        end
      end
    end
  end
end

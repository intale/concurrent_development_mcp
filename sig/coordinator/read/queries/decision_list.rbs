module Coordinator
  module Read
    module Queries
      class DecisionList
        def initialize: (
          ?contract: Contracts::DecisionList,
          ?governance: Repositories::DecisionGovernance
        ) -> void
        # dry-operation prepends #call; runtime RBS wrapping recursively re-enters that wrapper.
        %a{rbs:test:skip}
        def call: (command_input input) -> QueryResultV1
      end
    end
  end
end

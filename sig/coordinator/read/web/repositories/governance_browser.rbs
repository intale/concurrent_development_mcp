module Coordinator
  module Read
    module Web
      module Repositories
        class GovernanceBrowser
          def initialize: (
            ?decisions: Read::Repositories::DecisionGovernance,
            ?utterances: Read::Repositories::UserUtterances,
            ?interpretations: Read::Repositories::DecisionInterpretations,
            ?choices: Read::Repositories::AgentChoices,
            ?impacts: Read::Repositories::AgentChoiceImpacts,
            ?completion_contract: Contracts::GovernanceBrowser::CommandCompletion
          ) -> void
          def decisions: (GovernanceBrowserQueryV1::Decisions query) -> GovernanceBrowserV1::DecisionPage?
          def guidance_list: (GovernanceBrowserQueryV1::GuidanceList query) -> GovernanceBrowserV1::GuidancePage?
          def choices: (GovernanceBrowserQueryV1::Choices query) -> GovernanceBrowserV1::AgentChoicePage?
          def impacts: (GovernanceBrowserQueryV1::Impacts query) -> GovernanceBrowserV1::ImpactPage?
          def decision: (GovernanceBrowserQueryV1::Decision query) -> GovernanceBrowserV1::DecisionDetail?
          def guidance: (GovernanceBrowserQueryV1::Guidance query) -> GovernanceBrowserV1::GuidanceDetail?
          def choice: (GovernanceBrowserQueryV1::Choice query) -> GovernanceBrowserV1::ChoiceDetail?
          def impact: (GovernanceBrowserQueryV1::Impact query) -> GovernanceBrowserV1::ImpactDetail?
          def receipts: (GovernanceBrowserQueryV1::Receipts query) -> GovernanceBrowserV1::ReceiptPage
          def receipt: (GovernanceBrowserQueryV1::Receipt query) -> GovernanceBrowserV1::ReceiptDetail?

          private

          def project_repository_ids: (String project_scope) -> Array[String]?
          def decisions_for_project: (Array[String] repository_ids) -> untyped
          def impact_page: (
            relation: untyped,
            outcome: String?,
            after_global_position: Integer?,
            after_assessment_id: String?,
            limit: Integer
          ) -> GovernanceBrowserV1::ImpactPage
          def guidance_for_project: (Array[String] repository_ids) -> untyped
          def choices_for_project: (Array[String] repository_ids) -> untyped
          def impacts_for_project: (Array[String] repository_ids) -> untyped
          def attempts_for_project: (Array[String] repository_ids) -> untyped
          def build_receipt: (untyped record) -> GovernanceBrowserV1::CommandReceipt
          def load_completion: (untyped record) -> Hash[Symbol, untyped]
          def verify_projection!: (untyped record, Hash[Symbol, untyped] completion) -> void
          def build_event_reference: (Hash[Symbol, untyped] attributes) -> GovernanceBrowserV1::EventReference
        end
      end
    end
  end
end

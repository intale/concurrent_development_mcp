module Coordinator
  module Read
    module Web
      class ProjectResourcesV1
        class Resource < Shared::Value
          def resource_id: () -> String
          def repository_id: () -> String
          def kind: () -> String
          def path: () -> String
          def lifecycle_status: () -> String
          def unbinding_reason: () -> String?
          def registered_event_id: () -> String?
          def registered_actor_id: () -> String?
          def registered_at: () -> String?
          def latest_transition_event_id: () -> String?
          def latest_transition_actor_id: () -> String?
          def last_transition_at: () -> String?
        end

        class WorkIntention < Shared::Value
          def intention_id: () -> String
          def intention_set_id: () -> String
          def resource_id: () -> String
          def repository_id: () -> String
          def resource_kind: () -> String
          def resource_path: () -> String
          def resource_lifecycle_status: () -> String?
          def status: () -> String
          def base_blob_oid: () -> String?
          def mode: () -> String
          def purpose: () -> String
          def context: () -> String?
          def fencing_token: () -> Integer
          def policy_version: () -> String
          def change_set_id: () -> String
          def work_item_id: () -> String
          def attempt_id: () -> String
          def agent_id: () -> String
          def declared_event_id: () -> String
          def last_expanded_event_id: () -> String?
          def last_renewed_event_id: () -> String?
          def withdrawal_event_id: () -> String?
          def attempt_terminal_event_id: () -> String?
          def declared_at: () -> String
          def last_expanded_at: () -> String?
          def last_renewed_at: () -> String?
          def previous_expires_at: () -> String?
          def expires_at: () -> String
          def withdrawn_at: () -> String?
          def attempt_terminal_at: () -> String?
          def updated_at: () -> String
        end

        class ResourcePage < Shared::Value
          def items: () -> Array[Resource]
          def next_resource_id: () -> String?
          def next_updated_at: () -> String?
          def has_more: () -> bool
        end

        class WorkIntentionPage < Shared::Value
          def items: () -> Array[WorkIntention]
          def next_intention_id: () -> String?
          def next_updated_at: () -> String?
          def has_more: () -> bool
          def as_of: () -> String
        end
      end
    end
  end
end

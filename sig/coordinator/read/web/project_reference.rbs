module Coordinator
  module Read
    module Web
      class ProjectReference
        SCHEMA_VERSION: String

        class InvalidReference < ArgumentError
        end

        class PayloadContract < Dry::Validation::Contract
        end

        def initialize: (
          ?payload_contract: PayloadContract,
          ?scope_contract: Contracts::RepositoryList,
          ?canonical_json: Shared::CanonicalJson
        ) -> void

        def encode: (scope: String) -> String
        def decode: (String reference) -> String

        private

        def validate_scope!: (String scope) -> void
      end
    end
  end
end

module Coordinator
  module Read
    module Web
      class GovernanceBrowserQueryV1
        class Decisions < Shared::Value
          def project_scope: () -> String
          def first: () -> Integer
          def topic_id: () -> String?
          def policy_status: () -> String?
          def after_decision_id: () -> String?
        end

        class GuidanceList < Shared::Value
          def project_scope: () -> String
          def first: () -> Integer
          def source: () -> String?
          def after_message_id: () -> String?
        end

        class Choices < Shared::Value
          def project_scope: () -> String
          def first: () -> Integer
          def choice_type: () -> String?
          def status: () -> String?
          def after_choice_id: () -> String?
        end

        class Impacts < Shared::Value
          def project_scope: () -> String
          def first: () -> Integer
          def outcome: () -> String?
          def after_global_position: () -> Integer?
          def after_assessment_id: () -> String?
        end

        class Decision < Shared::Value
          def project_scope: () -> String
          def decision_id: () -> String
        end

        class Guidance < Shared::Value
          def project_scope: () -> String
          def message_id: () -> String
          def first: () -> Integer
          def after_revision: () -> Integer
        end

        class Choice < Shared::Value
          def project_scope: () -> String
          def choice_id: () -> String
          def first: () -> Integer
          def after_impact_global_position: () -> Integer?
          def after_impact_assessment_id: () -> String?
        end

        class Impact < Shared::Value
          def project_scope: () -> String
          def assessment_id: () -> String
        end

        class Receipts < Shared::Value
          def first: () -> Integer
          def tool_name: () -> String?
          def status: () -> String?
          def after_command_id: () -> String?
        end

        class Receipt < Shared::Value
          def command_id: () -> String
        end
      end
    end
  end
end

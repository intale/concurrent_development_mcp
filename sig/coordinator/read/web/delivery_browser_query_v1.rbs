module Coordinator
  module Read
    module Web
      class DeliveryBrowserQueryV1
        class Candidates < Shared::Value
          def project_scope: () -> String
          def first: () -> Integer
          def sort: () -> String
          def change_set_id: () -> String?
          def checkpoint_kind: () -> String?
          def after_updated_at: () -> String?
          def after_id: () -> String?
        end

        class Obligations < Shared::Value
          def project_scope: () -> String
          def first: () -> Integer
          def sort: () -> String
          def change_set_id: () -> String?
          def status: () -> String?
          def after_updated_at: () -> String?
          def after_id: () -> String?
        end

        class Merges < Shared::Value
          def project_scope: () -> String
          def first: () -> Integer
          def sort: () -> String
          def after_updated_at: () -> String?
          def after_id: () -> String?
        end

        class Releases < Shared::Value
          def project_scope: () -> String
          def first: () -> Integer
          def sort: () -> String
          def change_set_id: () -> String?
          def status: () -> String?
          def after_updated_at: () -> String?
          def after_id: () -> String?
        end

        class Candidate < Shared::Value
          def project_scope: () -> String
          def candidate_id: () -> String
          def direction: () -> String
          def first: () -> Integer
          def after_impact_position: () -> Integer?
        end

        class Verification < Shared::Value
          def project_scope: () -> String
          def obligation_id: () -> String
          def first: () -> Integer

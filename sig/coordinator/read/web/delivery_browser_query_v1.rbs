        end

        class Batches < Shared::Value
          def first: () -> Integer
          def sort: () -> String
          def target_tool: () -> String?
          def status: () -> String?
          def after_updated_at: () -> String?
          def after_id: () -> String?
        end

        class Batch < Shared::Value

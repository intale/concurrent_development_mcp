module Coordinator
  module Read
    module Web
      class DeliveryBrowserQueryV1
        class Catalog < Shared::Value
          def repository_id: () -> String
          def first: () -> Integer
          def sort: () -> String
          def candidate_change_set_id: () -> String?
          def candidate_checkpoint_kind: () -> String?
          def candidate_after_position: () -> Integer?
          def candidate_after_id: () -> String?
          def obligation_change_set_id: () -> String?
          def obligation_status: () -> String?
          def obligation_after_position: () -> Integer?
          def obligation_after_id: () -> String?
          def merge_after_position: () -> Integer?
          def merge_after_id: () -> String?
          def release_change_set_id: () -> String?
          def release_status: () -> String?
          def release_after_position: () -> Integer?
          def release_after_id: () -> String?
        end

        class Candidate < Shared::Value
          def repository_id: () -> String
          def candidate_id: () -> String
          def direction: () -> String
          def first: () -> Integer
          def after_impact_position: () -> Integer?
        end

        class Verification < Shared::Value
          def repository_id: () -> String
          def obligation_id: () -> String
          def first: () -> Integer
          def after_evidence_position: () -> Integer?
          def after_evidence_id: () -> String?
        end

        class Merge < Shared::Value
          def repository_id: () -> String
          def merge_snapshot_id: () -> String
          def first: () -> Integer
          def after_authorization_position: () -> Integer?
          def after_authorization_id: () -> String?
        end

        class Release < Shared::Value
          def repository_id: () -> String
          def release_set_id: () -> String
        end

        class Batches < Shared::Value
          def first: () -> Integer
          def sort: () -> String
          def target_tool: () -> String?
          def status: () -> String?
          def after_position: () -> Integer?
          def after_id: () -> String?
        end

        class Batch < Shared::Value
          def batch_id: () -> String
          def first: () -> Integer
          def after_index: () -> Integer?
        end
      end
    end
  end
end

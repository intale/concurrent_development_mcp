module Coordinator
  module Read
    module Web
      class KnowledgeBrowserQueryV1
        class Catalog < Shared::Value
          def repository_id: () -> String
          def first: () -> Integer
          def skill_name: () -> String?
          def after_skill_id: () -> String?
          def artifact_kind: () -> String?
          def artifact_labels: () -> Array[String]
          def artifact_source_kind: () -> String?
          def after_artifact_global_position: () -> Integer?
        end

        class Skill < Shared::Value
          def repository_id: () -> String
          def name: () -> String
        end

        class SkillAsset < Shared::Value
          def repository_id: () -> String
          def name: () -> String
          def path: () -> String
        end

        class Artifact < Shared::Value
          def repository_id: () -> String
          def artifact_id: () -> String
          def first: () -> Integer
          def direction: () -> String
          def relation: () -> String?
          def cursor: () -> Read::DevelopmentArtifactRelationPageV1::Cursor
        end
      end
    end
  end
end

module Coordinator
  module Read
    module Web
      class KnowledgeBrowserQueryV1
        class Skills < Shared::Value
          def project_ref: () -> String?
          def scope: () -> String?
          def first: () -> Integer
          def name: () -> String?
          def after_updated_at: () -> String?
          def after_skill_id: () -> String?
        end

        class SkillById < Shared::Value
          def skill_id: () -> String
        end

        class SkillAssetById < Shared::Value
          def skill_id: () -> String
          def path: () -> String
        end

        class Artifacts < Shared::Value
          def project_ref: () -> String
          def scope: () -> String
          def first: () -> Integer
          def kind: () -> String?
          def labels: () -> Array[String]
          def source_kind: () -> String?
          def after_updated_at: () -> String?
          def after_observation_id: () -> String?
        end

        class Skill < Shared::Value
          def project_ref: () -> String
          def scope: () -> String
          def name: () -> String
        end

        class SkillAsset < Shared::Value
          def project_ref: () -> String
          def scope: () -> String
          def name: () -> String
          def path: () -> String
        end

        class Artifact < Shared::Value
          def project_ref: () -> String
          def scope: () -> String
          def artifact_id: () -> String
        end

        class Relationships < Shared::Value
          def project_ref: () -> String
          def scope: () -> String
          def artifact_id: () -> String
          def first: () -> Integer
          def direction: () -> String
          def relation: () -> String?
          def cursor: () -> Read::DevelopmentArtifactRelationPageV1::Cursor
        end
      end
    end
  end
end

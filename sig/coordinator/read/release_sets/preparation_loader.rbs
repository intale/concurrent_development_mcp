module Coordinator
  module Read
    module ReleaseSets
      type preparation = { change_set_id: String, ordered_members: Array[CommandResults::document], created_at: Time }
      interface _PreparationLoader
        def call: (String release_set_id, through_revision: Integer) -> preparation
      end
      class PreparationLoader
        def initialize: (event_store: Write::EventStore, ?stream_factory: Write::StreamFactory) -> void
        def call: (String release_set_id, through_revision: Integer) -> preparation
      end
    end
  end
end

module Coordinator
  module Read
    class DecisionViewV1 < Shared::Value
      def decision_id: () -> String
      def interpretation_id: () -> String
      def source_message_id: () -> String
      def policy_status: () -> String
      def definition: () -> Write::Decisions::DecisionDefinitionV1
      def slot: () -> Write::Decisions::DecisionSlotV1?
      def partitions: () -> Array[Write::Decisions::DecisionPartitionV1]
      def classifier: () -> Write::Interpretations::ClassifierAttributionV1
      def scope_provenance: () -> Write::Interpretations::DecisionScopeProvenanceV1
      def source_event: () -> Write::EventReference
      def proposal_event: () -> Write::EventReference
      def acceptance_event: () -> Write::EventReference
      def rationale: () -> Write::Decisions::DecisionActivationRationaleV1?
      def recorded: () -> DecisionLifecycleEvidenceV1
      def activated: () -> DecisionLifecycleEvidenceV1?
    end
  end
end

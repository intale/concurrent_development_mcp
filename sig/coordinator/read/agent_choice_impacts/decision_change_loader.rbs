module Coordinator::Read
  module AgentChoiceImpacts
    class DecisionChangeLoader
      @event_store: untyped

      @schema_registry: untyped

      @partition_builder: untyped

      @canonical_json: untyped

      def initialize: (event_store: untyped, ?schema_registry: untyped, ?partition_builder: untyped, ?canonical_json: untyped) -> void

      def call: (untyped reference) -> untyped

      private

      def definition_for: (untyped event, untyped payload) -> untyped

      def affected_partitions: (untyped event, untyped payload, untyped definition) -> untyped

      def change_kind: (untyped payload) -> ("activated" | "corrected")

      def definition_before: (untyped event) -> untyped

      def normalize_definition: (untyped document) -> untyped

      def load_event: (untyped event) -> untyped
    end
  end
end

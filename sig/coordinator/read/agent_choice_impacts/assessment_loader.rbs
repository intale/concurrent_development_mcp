module Coordinator::Read
  module AgentChoiceImpacts
    interface _AssessmentLoader
      def call: (String assessment_id) -> AssessmentViewV2?
    end

    class AssessmentLoader
      @event_store: untyped

      @stream_factory: untyped

      @schema_registry: untyped

      @decision_change_loader: untyped

      EVENT_TYPES: ::Array["AgentChoiceImpactAssessmentRecorded" | "AgentChoiceImpactSourceLinked"]

      def initialize: (event_store: untyped, ?stream_factory: untyped, ?schema_registry: untyped, ?decision_change_loader: untyped) -> void

      def call: (untyped assessment_id) -> untyped

      private

      def load_event: (untyped event) -> untyped
    end
  end
end

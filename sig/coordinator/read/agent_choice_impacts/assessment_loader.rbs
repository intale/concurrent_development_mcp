module Coordinator
  module Read
    module AgentChoiceImpacts
      type assessment_source = {
        assessment_id: String, choice_id: String, attempt_id: String,
        assessment: CommandResults::document, accepted_choice: CommandResults::document,
        decision_change: CommandResults::document, decision_changed_at: String,
        assessment_event: PgEventstore::Event
      }

      interface _AssessmentLoader
        def call: (String assessment_id) -> assessment_source
      end

      class AssessmentLoader
        EVENT_TYPES: Array[String]
        def initialize: (event_store: Write::_EventStore, ?stream_factory: Write::StreamFactory, ?decision_change_loader: DecisionChangeLoader) -> void
        def call: (String assessment_id) -> assessment_source
      end
    end
  end
end

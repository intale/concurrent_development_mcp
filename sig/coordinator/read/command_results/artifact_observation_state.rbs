module Coordinator
  module Read
    module CommandResults
      class ArtifactObservationState < Shared::Value
        def self.reduce: (Array[Write::Events::Base] events) -> ArtifactObservationState

        def observation: () -> Write::Events::DevelopmentArtifactObservedV1
        def corrections: () -> Array[Write::Events::DevelopmentArtifactClassificationCorrectedV1]
        def classification_revision: () -> Integer
        def title: () -> String
        def kind: () -> String
        def labels: () -> Array[String]
      end
    end
  end
end

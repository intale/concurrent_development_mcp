module Coordinator
  module Read
    module CoordContexts
      interface _SourceLoader
        def call: (PgEventstore::Event event) -> CommandResults::document?
      end
      class SourceLoader
        include _SourceLoader
        COMPONENT_TYPES: Array[String]
        def initialize: (event_store: Write::EventStore, submission_loader: Candidates::_SubmissionLoader,
          ?change_set_definition_loader: ChangeSets::DefinitionLoader, ?work_item_definition_loader: WorkItems::DefinitionLoader,
          ?work_item_completion_loader: WorkItems::CompletionLoader, ?attempt_definition_loader: Attempts::DefinitionLoader,
          ?work_intention_set_loader: WorkIntentionSetLoader) -> void
        private
        def candidate: (String id) -> CommandResults::document
      end
    end
  end
end

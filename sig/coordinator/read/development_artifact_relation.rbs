module Coordinator
  module Read
    class DevelopmentArtifactRelation < ApplicationRecord
      def relation_id: () -> String
      def source_artifact_id: () -> String
      def relation: () -> String
      def target_kind: () -> String
      def target_id: () -> String
      def path: () -> String?
      def declared_event: () -> Hash[String, untyped]
      def declared_actor: () -> Hash[String, untyped]
      def declared_markers: () -> Array[String]
      def declared_metadata: () -> Hash[String, untyped]
      def declared_causation_id: () -> String?
      def declared_correlation_id: () -> String?
      def declared_global_position: () -> Integer
      def declared_at_domain: () -> Time
      def declared_at_store: () -> Time
      def source_artifact: () -> DevelopmentArtifact?
    end
  end
end

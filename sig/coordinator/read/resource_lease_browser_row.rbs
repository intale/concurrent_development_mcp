module Coordinator
  module Read
    class ResourceLeaseBrowserRow < ApplicationRecord
      def readonly?: () -> bool
      def lease_id: () -> String
      def resource_id: () -> String
      def lease_set_id: () -> String
      def repository_id: () -> String
      def project_scope: () -> String
      def project_name: () -> String?
      def resource_kind: () -> String
      def resource_path: () -> String
      def resource_lifecycle_status: () -> String?
      def base_blob_oid: () -> String?
      def fencing_token: () -> Integer
      def policy_version: () -> String
      def change_set_id: () -> String
      def work_item_id: () -> String
      def attempt_id: () -> String
      def agent_id: () -> String
      def reserved_event: () -> Hash[String, untyped]
      def reserved_at_domain: () -> Time
      def last_expanded_event: () -> Hash[String, untyped]?
      def last_expanded_at_domain: () -> Time?
      def last_renewed_event: () -> Hash[String, untyped]?
      def last_renewed_at_domain: () -> Time?
      def previous_expires_at_domain: () -> Time?
      def expires_at_domain: () -> Time
      def release_event: () -> Hash[String, untyped]?
      def released_at_domain: () -> Time?
      def attempt_terminal_event: () -> Hash[String, untyped]?
      def attempt_terminal_at_domain: () -> Time?
      def last_projected_at: () -> Time
    end
  end
end

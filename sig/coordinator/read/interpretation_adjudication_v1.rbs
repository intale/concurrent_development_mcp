module Coordinator
  module Read
    class InterpretationAdjudicationV1 < Shared::Value
      def action: () -> String
      def outcome: () -> String
      def rationale: () -> Write::Interpretations::AdjudicationRationaleV1?
      def clarification: () -> Write::Interpretations::AdjudicationClarificationV1?

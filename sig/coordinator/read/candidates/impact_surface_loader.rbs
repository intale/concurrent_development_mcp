module Coordinator::Read
  module Candidates
    interface _ImpactSurfaceLoader
      def call: (String surface_id) -> Coordinator::Read::CandidateImpactSurfaceSourceV2?
    end

    class ImpactSurfaceLoader
      @event_store: untyped

      @stream_factory: untyped

      @schema_registry: untyped

      def initialize: (event_store: untyped, ?stream_factory: untyped, ?schema_registry: untyped) -> void

      def call: (untyped surface_id) -> untyped
    end
  end
end

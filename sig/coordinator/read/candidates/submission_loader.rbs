module Coordinator
  module Read
    module Candidates
      interface _SubmissionLoader
        def call: (String candidate_id) -> CandidateSubmissionViewV2
      end
      class SubmissionLoader
        FACT_TYPES: Array[String]
        def initialize: (event_store: Write::_EventStore, ?stream_factory: Write::StreamFactory, ?fact_reader: CommandResults::FactReader) -> void
        def call: (String candidate_id) -> CandidateSubmissionViewV2
        private
        def intention_references: (Array[Hash[String, CommandResults::json]] references) -> Array[CommandResults::document]
      end
    end
  end
end

module Coordinator
  module Read
    module Projections
      class CoordContextStateV1 < Shared::Value
        RECENT_ATTEMPT_LIMIT: Integer
        HISTORICAL_RESOURCE_KEY_POLICY_VERSIONS: Array[String]

        class ChangeSet < Shared::Value
          def change_set_id: () -> String
          def goal: () -> String
          def acceptance_criteria: () -> Array[String]
          def status: () -> String
          def created_at: () -> String
          def activated_at: () -> String?
          def completed_at: () -> String?
        end

        class WorkItem < Shared::Value
          def work_item_id: () -> String
          def change_set_id: () -> String
          def repository_id: () -> String
          def goal: () -> String
          def acceptance_criteria: () -> Array[String]
          def competitive_mode: () -> bool
          def status: () -> String
          def active_attempt_id: () -> String?
          def active_agent_id: () -> String?
          def selected_candidate_id: () -> String?
          def selected_candidate_event: () -> Write::EventReference?
          def produced_outputs: () -> Array[Write::WorkItemOutputV1]
          def created_at: () -> String
          def made_ready_at: () -> String?
          def acquired_at: () -> String?
          def selected_at: () -> String?
          def completed_at: () -> String?
        end

        class Dependency < Shared::Value
          def dependency_id: () -> String
          def producer_work_item_id: () -> String
          def consumer_work_item_id: () -> String
          def dependency_kind: () -> String
          def required_output: () -> Write::RequiredOutput?
          def source_event: () -> Write::EventReference?
          def declared_at: () -> String
          def satisfied_at: () -> String?
        end

        class WriteSetResource < Shared::Value
          def lease_id: () -> String
          def resource_key: () -> String
          def resource_key_hash: () -> String
          def resource_kind: () -> String
          def resource_path: () -> String
          def base_blob_oid: () -> String?
          def fencing_token: () -> Integer
        end

        class WriteSetResourceV2 < Shared::Value
          def lease_id: () -> String
          def resource_id: () -> String
          def resource_kind: () -> String
          def resource_path: () -> String
          def base_blob_oid: () -> String?
          def fencing_token: () -> Integer
        end

        class WriteSet < Shared::Value
          def lease_set_id: () -> String
          def repository_id: () -> String
          def policy_version: () -> String
          def resources: () -> Array[WriteSetResource | WriteSetResourceV2]
          def reserved_at: () -> String
          def last_expanded_at: () -> String?
          def last_renewed_at: () -> String?
          def previous_expires_at: () -> String?
          def expires_at: () -> String
          def released_at: () -> String?
        end

        class Attempt < Shared::Value
          def attempt_id: () -> String
          def change_set_id: () -> String
          def work_item_id: () -> String
          def agent_id: () -> String
          def base_snapshots: () -> Array[Write::RepositorySnapshotV1]
          def status: () -> String
          def authorized_at: () -> String
          def started_at: () -> String?
          def write_set: () -> WriteSet?
          def selected_candidate_id: () -> String?
          def selected_candidate_event: () -> Write::EventReference?
          def completed_at: () -> String?
          def abandonment_reason: () -> String?
          def abandoned_at: () -> String?
        end

        class CandidateCheckpoint < Shared::Value
          def candidate_id: () -> String
          def candidate_event: () -> Write::EventReference
          def change_set_id: () -> String
          def work_item_id: () -> String
          def attempt_id: () -> String
          def repository_id: () -> String
          def target_branch: () -> String
          def object_format: () -> String
          def base_commit_oid: () -> String
          def head_commit_oid: () -> String
          def checkpoint_kind: () -> String
          def manifest_digest: () -> String
          def build_context_digest: () -> String?
          def attached_at: () -> String
        end

        def self.initial: () -> CoordContextStateV1
        def schema: () -> String
        def change_set: () -> ChangeSet?
        def work_item_ids: () -> Array[String]
        def work_items: () -> Array[WorkItem]
        def dependencies: () -> Array[Dependency]
        def attempts: () -> Array[Attempt]
        def candidate_checkpoints: () -> Array[CandidateCheckpoint]
      end
    end
  end
end

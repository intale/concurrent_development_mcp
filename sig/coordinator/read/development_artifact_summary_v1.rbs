module Coordinator
  module Read
    class DevelopmentArtifactSummaryV1 < Shared::Value
      def artifact_id: () -> String
      def observation_id: () -> String
      def scope: () -> String
      def title: () -> String
      def kind: () -> String
      def labels: () -> Array[String]
      def media_type: () -> String
      def encoding: () -> String
      def content_sha256: () -> String
      def byte_size: () -> Integer
      def source: () -> DevelopmentArtifactProvenanceV1
      def classification_revision: () -> Integer
      def classification_reason: () -> String?
      def relationship_count: () -> Integer
      def relationship_capacity: () -> DevelopmentArtifactRelationshipCapacityV1
      def captured: () -> DevelopmentArtifactEventEvidenceV1
      def observed: () -> DevelopmentArtifactEventEvidenceV1
      def classified: () -> DevelopmentArtifactEventEvidenceV1
    end
  end
end

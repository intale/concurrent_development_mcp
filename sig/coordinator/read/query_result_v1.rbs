module Coordinator
  module Read
    class QueryResultV1 < Shared::Value
      class EmptyData < Shared::Value
      end

      class DomainError < Shared::Value
        def code: () -> String
        def message: () -> String
        def details: () -> Hash[Symbol | String, untyped]
      end

      class OperationData < Shared::Value
        def result: () -> Write::CommandReceiptData::value
        def emitted_events: () -> Array[Write::EventReference]
      end

      class ContextData < Shared::Value
        def scope: () -> ContextTokenDocument::scope
        def context: () -> Projections::CoordContextStateV1
        def blockers: () -> Array[ContextBlockerV1]
        def last_processed_at: () -> String
      end

      class NotModifiedData < Shared::Value
        def scope: () -> ContextTokenDocument::scope
        def last_processed_at: () -> String
      end

      class GuidanceData < Shared::Value
        def guidance: () -> GuidanceUtteranceV1
      end

      class InterpretationPageData < Shared::Value
        def page: () -> InterpretationPageV1
      end

      class DecisionData < Shared::Value
        def decision: () -> DecisionViewV1
      end

      class DecisionContextData < Shared::Value
        def decision_context: () -> DecisionResolution::ContextV1
      end

      class AgentChoiceData < Shared::Value
        def choice: () -> AgentChoiceViewV1
      end

      class AgentChoiceImpactPageData < Shared::Value
        def page: () -> AgentChoiceImpactPageV1
      end

      class CandidateData < Shared::Value
        def candidate: () -> CandidateViewV1
      end

      class CandidatePageData < Shared::Value
        def page: () -> CandidatePageV1
      end

      class CandidateImpactData < Shared::Value
        def page: () -> CandidateImpactPageV1
      end

      class VerificationObligationPageData < Shared::Value
        def page: () -> VerificationObligationPageV1
      end

      class MergeSnapshotData < Shared::Value
        def snapshot: () -> MergeSnapshotViewV1
      end

      class ReleaseSetData < Shared::Value
        def release_set: () -> ReleaseSetViewV1
      end

      class SkillData < Shared::Value
        def skill: () -> SkillViewV1
      end

      class SkillPageData < Shared::Value
        def page: () -> SkillPageV1
      end

      class SkillAssetData < Shared::Value
        def asset: () -> SkillAssetViewV1
      end

      type data = EmptyData | DomainError | OperationData | ContextData | NotModifiedData | GuidanceData | InterpretationPageData | DecisionData | DecisionContextData | AgentChoiceData | AgentChoiceImpactPageData | CandidateData | CandidatePageData | CandidateImpactData | VerificationObligationPageData | MergeSnapshotData | ReleaseSetData | SkillData | SkillPageData | SkillAssetData
      type action = Write::NextAction | NextAction

      def status: () -> String
      def summary: () -> String
      def command_id: () -> String?
      def receipt: () -> String?
      def context_token: () -> String?
      def data: () -> data
      def warnings: () -> Array[String]
      def next_actions: () -> Array[action]
    end
  end
end

module Coordinator
  module Read
    class DevelopmentArtifactRelationViewV1 < Shared::Value
      def relation_id: () -> String
      def source_artifact_id: () -> String
      def relation: () -> String
      def display_relation: () -> String
      def inverse_relation: () -> String
      def transitive: () -> bool
      def supersedable: () -> bool
      def target: () -> Write::DevelopmentArtifacts::RelationTargetV1
      def attributes: () -> Hash[Symbol, untyped]
      def relation_attributes: () -> Write::DevelopmentArtifacts::RelationAttributesV1
      def direction: () -> String
      def peer_kind: () -> String
      def peer_id: () -> String
      def peer_artifact: () -> DevelopmentArtifactSummaryV1?
      def status: () -> String

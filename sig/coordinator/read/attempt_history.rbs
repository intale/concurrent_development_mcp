module Coordinator
  module Read
    class AttemptHistory < ApplicationRecord
      def attempt_id: () -> String
      def change_set_id: () -> String
      def work_item_id: () -> String
      def agent_id: () -> String
      def base_snapshots: () -> Array[Hash[String, untyped]]
      def status: () -> String
      def authorization_event: () -> Hash[String, untyped]
      def authorized_global_position: () -> Integer
      def authorized_at_domain: () -> Time
      def started_at_domain: () -> Time?
      def selected_candidate_id: () -> String?
      def selected_candidate_event: () -> Hash[String, untyped]?
      def abandonment_reason: () -> String?
      def terminal_event: () -> Hash[String, untyped]?
      def terminal_at_domain: () -> Time?
      def work_intention_set_id: () -> String?
      def work_intention_set_repository_id: () -> String?
      def work_intention_set_policy_version: () -> String?
      def work_intention_set_intentions: () -> Array[Hash[String, untyped]]
      def work_intention_set_declared_event: () -> Hash[String, untyped]?
      def work_intention_set_declared_at_domain: () -> Time?
      def work_intention_set_last_expanded_event: () -> Hash[String, untyped]?
      def work_intention_set_last_expanded_at_domain: () -> Time?
      def work_intention_set_last_renewed_event: () -> Hash[String, untyped]?
      def work_intention_set_last_renewed_at_domain: () -> Time?
      def work_intention_set_previous_expires_at_domain: () -> Time?
      def work_intention_set_expires_at_domain: () -> Time?
      def work_intention_set_withdrawal_event: () -> Hash[String, untyped]?
      def work_intention_set_withdrawn_at_domain: () -> Time?
    end
  end
end

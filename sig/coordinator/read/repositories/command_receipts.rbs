module Coordinator
  module Read
    module Repositories
      class CommandReceipts
        def fetch: (String command_id) -> Coordinator::Write::CommandResults::ResultV1?
        def fetch_by_request_id: (String request_id) -> Coordinator::Write::CommandResults::ResultV1?
        def fetch_many: (Array[String] command_ids) -> Array[Coordinator::Write::CommandResults::ResultV1]
        def fetch_index: (Array[String] command_ids) -> Hash[String, Coordinator::Write::CommandResults::ResultV1]

        private

        def build: (CommandReceipt record) -> Coordinator::Write::CommandResults::ResultV1
      end
    end
  end
end

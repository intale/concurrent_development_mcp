module Coordinator
  module Read
    module Repositories
      class DevelopmentArtifacts
        def initialize: (?relation_registry: Shared::DevelopmentArtifactRelationRegistry, ?follow_action: DevelopmentArtifactRelationFollowAction) -> void
        def fetch: (String artifact_id, ?observation_id: String?) -> DevelopmentArtifactViewV1?
        def fetch_content: (String artifact_id, ?observation_id: String?) -> (DevelopmentArtifactTextContentViewV2 | DevelopmentArtifactBinaryContentViewV2)?
        def page: (DevelopmentArtifactListQueryV1 query) -> DevelopmentArtifactPageV1
        def relation_page: (DevelopmentArtifactRelationQueryV1 query) -> DevelopmentArtifactRelationPageV1
        def locator_page: (DevelopmentArtifactLocatorQueryV1 query) -> DevelopmentArtifactLocatorPageV1
      end
    end
  end
end

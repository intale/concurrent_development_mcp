module Coordinator
  module Read
    module Repositories
      class DevelopmentArtifacts
        def initialize: (?relation_registry: Shared::DevelopmentArtifactRelationRegistry, ?follow_action: DevelopmentArtifactRelationFollowAction) -> void
        def fetch: (String artifact_id, ?observation_id: String?) -> DevelopmentArtifactViewV1?
        def fetch_content: (String artifact_id, ?observation_id: String?) -> (DevelopmentArtifactTextContentViewV2 | DevelopmentArtifactBinaryContentViewV2)?
        def page: (DevelopmentArtifactListQueryV1 query) -> DevelopmentArtifactPageV1
        def relation_page: (DevelopmentArtifactRelationQueryV1 query) -> DevelopmentArtifactRelationPageV1
        def locator_page: (DevelopmentArtifactLocatorQueryV1 query) -> DevelopmentArtifactLocatorPageV1
        def store_created: (event: PgEventstore::Event, created: Write::Events::DevelopmentArtifactCreatedV1) -> DevelopmentArtifact
        def store_property: (event: PgEventstore::Event, fact: Write::Events::Base) -> DevelopmentArtifact
        def store_observation_recorded: (event: PgEventstore::Event, recorded: Write::Events::DevelopmentArtifactObservationRecordedV1) -> DevelopmentArtifactObservation
        def store_classification_recorded: (event: PgEventstore::Event, correction: Write::Events::DevelopmentArtifactClassificationCorrectionRecordedV1) -> DevelopmentArtifactObservation?
        def store_observation_fact_link: (
          event: PgEventstore::Event,
          link: Write::Events::DevelopmentArtifactObservationFactLinkedV1,
          observed_fact_event: PgEventstore::Event,
          observed_fact: Write::Events::Base
        ) -> DevelopmentArtifactObservation
        def store_relation_v2: (event: PgEventstore::Event, declaration: Write::Events::DevelopmentArtifactRelationDeclaredV2) -> DevelopmentArtifactRelation
        def store_supersession_v2: (event: PgEventstore::Event, supersession: Write::Events::DevelopmentArtifactRelationSupersededV2) -> DevelopmentArtifactRelationSupersession?
      end
    end
  end
end

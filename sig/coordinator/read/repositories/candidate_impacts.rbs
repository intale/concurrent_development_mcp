module Coordinator
  module Read
    module Repositories
      class CandidateImpacts
        OUTGOING_MATCH_SQL: String
        INCOMING_MATCH_SQL: String
        MATCH_SQL: Hash[String, String]
        SOURCE_KEY_DIRECTIONS: Array[String]
        TARGET_KEY_DIRECTIONS: Array[String]

        def initialize: (
          ?candidates: Candidates,
          ?policies: CandidateImpactPolicies
        ) -> void
        def store_manifest: (event: PgEventstore::Event, manifest: Write::Events::CandidateChangeManifestCapturedV2) -> void
        def store_build_context: (event: PgEventstore::Event, build_context: Write::Events::CandidateBuildContextCapturedV2) -> void
        def store_surface: (event: PgEventstore::Event, ?projection_event: PgEventstore::Event, surface: Write::Events::CandidateImpactSurfaceDerivedV2) -> Candidate
        def page: (CandidateImpactGetQueryV1 query) -> CandidateImpactPageV1?
      end
    end
  end
end

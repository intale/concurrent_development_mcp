module Coordinator
  module Read
    module Repositories
      class CandidateImpacts
        OUTGOING_MATCH_SQL: String
        INCOMING_MATCH_SQL: String
        MATCH_SQL: Hash[String, String]
        SOURCE_KEY_DIRECTIONS: Array[String]
        TARGET_KEY_DIRECTIONS: Array[String]

        def initialize: (?candidates: Candidates) -> void
        def store_manifest: (manifest: Write::Events::CandidateChangeManifestCapturedV1) -> void
        def store_build_context: (build_context: Write::Events::CandidateBuildContextCapturedV1) -> void
        def store_surface: (event: PgEventstore::Event, surface: Write::Events::CandidateImpactSurfaceDerivedV1) -> Candidate
        def page: (CandidateImpactGetQueryV1 query) -> CandidateImpactPageV1?
      end
    end
  end
end

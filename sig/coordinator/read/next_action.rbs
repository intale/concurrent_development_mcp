module Coordinator
  module Read
    class NextAction < Shared::Value
      type arguments = ChangeSetArguments | WorkItemArguments | AttemptArguments | WorkItemCompletionArguments | DevelopmentArtifactLocatorArguments

      class ChangeSetArguments < Shared::Value
        def change_set_id: () -> String
      end

      class WorkItemArguments < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
      end

      class AttemptArguments < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
      end
      class WorkItemCompletionArguments < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
        def candidate_id: () -> String
      end

      class DevelopmentArtifactLocatorArguments < Shared::Value
        def scope: () -> String
        def source_kind: () -> String
        def locator: () -> String
        def source_revision: () -> String?
        def cursor: () -> DevelopmentArtifactLocatorPageV1::Cursor
        def limit: () -> Integer
      end

      def tool: () -> String
      def arguments: () -> arguments
    end
  end
end

module Coordinator
  module Read
    module DecisionResolution
      class Resolver
        TOPIC_ID: String
        APPLICABILITY_REASONS: Array[String]
        ANCHOR_RANKS: Hash[String, Integer]

        def call: (
          context: QueryContextV1,
          observations: Array[PartitionObservationV1],
          decisions: Array[DecisionViewV1],
          resolved_at: String
        ) -> ResultV1
      end
    end
  end
end

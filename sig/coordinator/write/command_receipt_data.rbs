module Coordinator
  module Write
    module CommandReceiptData
      type value = ChangeSet | WorkItem | Dependency | Attempt | LeaseSet | LeaseSetExpansion | LeaseSetRenewal | LeaseSetRelease | ResourceLeaseExpiry | Guidance | InterpretationProposal | InterpretationAdjudication | DecisionActivation | DecisionCorrection | AgentChoice | CandidateSubmission | CandidateImpactSurface | VerificationObligationClaim | CompatibilityAssessment

      class ChangeSet < Shared::Value
        def change_set_id: () -> String
      end

      class WorkItem < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
      end

      class Dependency < Shared::Value
        def change_set_id: () -> String
        def dependency_id: () -> String
      end

      class Attempt < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
      end


      class LeaseSet < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
        def repository_id: () -> String
        def lease_set_id: () -> String
        def policy_version: () -> String
        def acquired_at: () -> String
        def expires_at: () -> String
        def resources: () -> Array[LeaseReferenceV1]
      end

      class LeaseSetExpansion < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
        def repository_id: () -> String
        def lease_set_id: () -> String
        def policy_version: () -> String
        def expanded_at: () -> String
        def expires_at: () -> String
        def added_resources: () -> Array[LeaseReferenceV1]
        def resource_count: () -> Integer
      end

      class LeaseSetRenewal < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
        def repository_id: () -> String
        def lease_set_id: () -> String
        def policy_version: () -> String
        def resources: () -> Array[LeaseReferenceV1]
        def resource_count: () -> Integer
        def renewed_at: () -> String
        def previous_expires_at: () -> String
        def expires_at: () -> String
      end

      class LeaseSetRelease < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
        def repository_id: () -> String
        def lease_set_id: () -> String
        def policy_version: () -> String
        def resources: () -> Array[LeaseReferenceV1]
        def resource_count: () -> Integer
        def previous_expires_at: () -> String
        def released_at: () -> String
      end

      class ResourceLeaseExpiry < Shared::Value
        def resource_key_hash: () -> String
        def lease_id: () -> String
        def lease_set_id: () -> String
        def fencing_token: () -> Integer
        def expires_at: () -> String
        def expired_at: () -> String
      end


      class Guidance < Shared::Value
        def message_id: () -> String
        def conversation_id: () -> String
        def source: () -> String
        def policy_status: () -> String
        def recorded_at: () -> String
      end

      class InterpretationProposal < Shared::Value
        def interpretation_id: () -> String
        def source_message_id: () -> String
        def assessment: () -> Interpretations::InterpretationAssessmentV1
        def proposed_at: () -> String
      end

      class InterpretationAdjudication < Shared::Value
        def interpretation_id: () -> String
        def source_message_id: () -> String
        def action: () -> String
        def outcome: () -> String
        def policy_status: () -> String
        def slot: () -> Interpretations::InterpretationSlotV1?
        def adjudicated_at: () -> String
      end

      class DecisionActivation < Shared::Value
        def decision_id: () -> String
        def interpretation_id: () -> String
        def outcome: () -> String
        def policy_status: () -> String
        def definition_digest: () -> String
        def slot: () -> Decisions::DecisionSlotV1?
        def partitions: () -> Array[Decisions::DecisionPartitionReceiptV1]
        def activated_at: () -> String
      end

      class DecisionCorrection < Shared::Value
        def decision_id: () -> String
        def interpretation_id: () -> String
        def outcome: () -> String
        def policy_status: () -> String
        def previous_definition_digest: () -> String
        def definition_digest: () -> String
        def correction_event: () -> EventReference
        def slot: () -> Decisions::DecisionSlotV1?
        def partitions: () -> Array[Decisions::DecisionPartitionReceiptV1]
        def corrected_at: () -> String
      end

      class AgentChoice < Shared::Value
        Head: singleton(Decisions::DecisionHeadV1)

        def choice_id: () -> String
        def choice_type: () -> String
        def outcome: () -> String
        def assessment_basis: () -> String
        def context_digest: () -> String
        def recorded_event: () -> EventReference
        def accepted_event: () -> EventReference
        def based_on_decisions: () -> Array[Decisions::DecisionHeadV1]
        def warnings: () -> Array[String]
        def accepted_at: () -> String
      end

      class CandidateSubmission < Shared::Value
        def candidate_id: () -> String
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
        def repository_id: () -> String
        def target_branch: () -> String
        def object_format: () -> String
        def base_commit_oid: () -> String
        def head_commit_oid: () -> String
        def checkpoint_kind: () -> String
        def manifest_digest: () -> String
        def build_context_digest: () -> String?
        def evidence_status: () -> String
        def candidate_event: () -> EventReference
        def submitted_at: () -> String
      end

      class CandidateImpactSurface < Shared::Value
        def candidate_id: () -> String
        def surface_digest: () -> String
        def evidence_revision: () -> Integer
        def evidence_status: () -> String
        def surface_event: () -> EventReference
        def registration_event: () -> EventReference
        def derived_at: () -> String
      end

      class VerificationObligationClaim < Shared::Value
        def obligation_id: () -> String
        def claim_id: () -> String
        def claimant_id: () -> String
        def fencing_token: () -> Integer
        def claimed_at: () -> String
        def expires_at: () -> String
        def claim_event: () -> EventReference
      end

      class CompatibilityAssessment < Shared::Value
        def obligation_id: () -> String
        def evidence_id: () -> String
        def evidence_kind: () -> String
        def conclusion: () -> String
        def status: () -> String
        def assessment_input_digest: () -> String
        def evidence_event: () -> EventReference
        def outcome_event: () -> EventReference?
        def submitted_at: () -> String
      end
    end
  end
end

module Coordinator
  module Write
    module CommandReceiptData
      type value = ChangeSet | WorkItem | Dependency | Attempt | LeaseSet | LeaseSetExpansion | LeaseSetRenewal

      class ChangeSet < Shared::Value
        def change_set_id: () -> String
      end

      class WorkItem < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
      end

      class Dependency < Shared::Value
        def change_set_id: () -> String
        def dependency_id: () -> String
      end

      class Attempt < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
      end


      class LeaseSet < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
        def repository_id: () -> String
        def lease_set_id: () -> String
        def policy_version: () -> String
        def acquired_at: () -> String
        def expires_at: () -> String
        def resources: () -> Array[LeaseReferenceV1]
      end

      class LeaseSetExpansion < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
        def repository_id: () -> String
        def lease_set_id: () -> String
        def policy_version: () -> String
        def expanded_at: () -> String
        def expires_at: () -> String
        def added_resources: () -> Array[LeaseReferenceV1]
        def resource_count: () -> Integer
      end

      class LeaseSetRenewal < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
        def repository_id: () -> String
        def lease_set_id: () -> String
        def policy_version: () -> String
        def resources: () -> Array[LeaseReferenceV1]
        def resource_count: () -> Integer
        def renewed_at: () -> String
        def previous_expires_at: () -> String
        def expires_at: () -> String
      end
    end
  end
end

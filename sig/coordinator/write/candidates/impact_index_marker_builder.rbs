module Coordinator::Write
  module Candidates
    class ImpactIndexMarkerBuilder
      POLICY_VERSION: String

      def initialize: (
        ?compound_marker_builder: Coordinator::Shared::CompoundMarkerBuilder
      ) -> void
      def call: (
        evidence: ImpactSurfaceEvidenceV2,
        surface: Coordinator::Write::Events::CandidateImpactSurfaceDerivedV2
      ) -> Array[String]
      def call_documents: (
        repository_id: String,
        manifest: Coordinator::Write::Events::CandidateChangeManifestCapturedV2,
        build_context: Coordinator::Write::Events::CandidateBuildContextCapturedV2?,
        surface: Coordinator::Write::Events::CandidateImpactSurfaceDerivedV2
      ) -> Array[String]
      def counterpart: (
        evidence: ImpactSurfaceEvidenceV2,
        surface: Coordinator::Write::Events::CandidateImpactSurfaceDerivedV2,
        direction: String
      ) -> Array[String]
      def counterpart_documents: (
        repository_id: String,
        manifest: Coordinator::Write::Events::CandidateChangeManifestCapturedV2,
        build_context: Coordinator::Write::Events::CandidateBuildContextCapturedV2?,
        surface: Coordinator::Write::Events::CandidateImpactSurfaceDerivedV2,
        direction: String
      ) -> Array[String]
    end
  end
end

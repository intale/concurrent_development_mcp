module Coordinator::Write::MergeObservations
  class ObservationDocumentV1 < Coordinator::Shared::Value
    def schema: () -> String
    def merge_snapshot_id: () -> String
    def authorization_event: () -> Coordinator::Write::EventReference
    def authorization_decision_digest: () -> String

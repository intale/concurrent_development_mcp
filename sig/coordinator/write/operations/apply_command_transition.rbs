module Coordinator
  module Write
    module Operations
      class ApplyCommandTransition
        def initialize: (
          event_store: _EventStore,
          ?loader: CommandLifecycle::Loader,
          ?stream_factory: StreamFactory,
          ?event_factory: EventFactory,
          ?id_generator: ::Coordinator::Shared::IdGenerator,
          ?revision_retry: OptimisticRevisionRetry
        ) -> void

        def call: (
          command: Commands::SucceedCommand | Commands::RejectCommand | Commands::FailCommand,
          decider: Domain::CommandLifecycles::Succeed | Domain::CommandLifecycles::Reject | Domain::CommandLifecycles::Fail,
          actor: Commands::Actor,
          tool_name: String,
          caused_by: PgEventstore::Event,
          ?event_id: String
        ) -> Dry::Monads::Result
      end
    end
  end
end

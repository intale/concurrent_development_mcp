module Coordinator
  module Write
    module Operations
      class SubmitCoordinationTask
        MAX_ATTEMPTS: Integer
        POLL_INTERVAL_MS: Integer

        def initialize: (
          event_store: _EventStore,
          ?decider: Domain::CoordinationTasks::Submit,
          ?input_digest: CommandInputDigest,
          ?clock: Shared::SystemClock,
          ?id_generator: Shared::IdGenerator,
          ?event_factory: EventFactory,
          ?stream_factory: StreamFactory,
          ?maximum_attempts: Integer
        ) -> void

        def call: (coordination_command target_command) -> Dry::Monads::Result
      end
    end
  end
end

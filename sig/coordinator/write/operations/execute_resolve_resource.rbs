        end

        def initialize: (
          event_store: _EventStore,
          ?contract: InputContract,
          ?normalizer: ResourceIdentityNormalizer,
          ?decider: Domain::Resources::Resolve,
          ?repository_registration_loader: RepositoryRegistrationLoader,

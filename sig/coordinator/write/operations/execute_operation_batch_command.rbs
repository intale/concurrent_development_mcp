module Coordinator
  module Write
    module Operations
      class ExecuteOperationBatchCommand
        def initialize: (event_store: _EventStore, ?loader: OperationBatches::Loader, ?decider: OperationBatches::Decider, ?input_digest: CommandInputDigest, ?clock: Shared::_Clock, ?id_generator: Shared::_IdGenerator, ?event_factory: EventFactory, ?schema_registry: EventSchemaRegistry, ?stream_factory: StreamFactory, ?completion_builder: CommandCompletionBuilder, ?outcome_contract: Contracts::OperationBatchItemOutcome) -> void
        def call_command: (Commands::CreateOperationBatch | Commands::CancelOperationBatch | Commands::RecordOperationBatchItemOutcome | Commands::RequestOperationBatchContinuation | Commands::CompleteOperationBatch | Commands::CompleteOperationBatchCancellation command, ?caused_by: PgEventstore::Event?) -> Dry::Monads::Result
      end
    end
  end
end

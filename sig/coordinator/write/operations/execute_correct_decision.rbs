        def initialize: (event_store: _EventStore, ?preparer: PrepareCorrectDecision, ?candidate_preparer: Domain::Decisions::PrepareCorrection, ?decider: Domain::Decisions::Correct, ?input_digest: CommandInputDigest, ?clock: Shared::_Clock, ?id_generator: Shared::_IdGenerator, ?event_factory: EventFactory, ?schema_registry: EventSchemaRegistry, ?stream_factory: StreamFactory, ?completion_builder: CommandCompletionBuilder, ?natural_key_registry: NaturalKeys::Registry, ?event_plan_contract: Contracts::DecisionCorrectionEventPlan) -> void

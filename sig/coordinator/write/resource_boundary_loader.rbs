module Coordinator
  module Write
    class ResourceBoundaryLoader
      class Delta < Shared::Value
        def events: () -> Array[PgEventstore::Event]
        def truncated: () -> bool
      end

      class Boundary < Shared::Value
        def marker: () -> String
        def epoch: () -> Integer
        def previous_through_global_position: () -> Integer?
        def through_global_position: () -> Integer?
        def delta_count: () -> Integer
        def truncated: () -> bool
        def states: () -> Array[Domain::ResourceLeases::State]
      end

      class Selection < Shared::Value
        def boundaries: () -> Array[Boundary]
        def states: () -> Array[Domain::ResourceLeases::State]
      end

      def initialize: (event_store: _EventStore, ?schema_registry: EventSchemaRegistry) -> void
      def call: (
        Array[String] markers,
        repository_id: String,
        ?maximum_delta_count: Integer,
        ?to_position: Integer,
        ?strict: bool
      ) -> Selection
      def snapshot_stream: (String repository_id) -> StreamReference
    end
  end
end

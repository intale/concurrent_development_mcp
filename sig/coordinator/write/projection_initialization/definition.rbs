module Coordinator
  module Write
    module ProjectionInitialization
      class Definition < Coordinator::Shared::Value
        ALL: Array[Definition]
        def context: () -> String
        def stream_name: () -> String
        def source_type: () -> String
        def target_types: () -> Array[String]
        def history_types: () -> Array[String]
        def history_maximum_count: () -> Integer?
        def matches?: (EventReference) -> bool
        def self.for_source: (EventReference) -> Definition?
      end
    end
  end
end

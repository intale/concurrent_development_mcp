module Coordinator
  module Write
    module Tasks
      module DomainErrorV1
        type domain_error = ChangeSetError | ActivationDependencyError | WorkItemError | DependencyError | AttemptError | CommandIdReusedError | LeaseBusyError | LeaseSetMismatchError | ResourceEvidenceConflictError | WriteSetLimitError | LeaseSetExpiredError | LeaseSetNotCurrentError | WriteSetReleasedError | LeaseSetSnapshotMismatchError | LeaseReferenceMismatchError | LeaseDeadlineNotExtendedError | MessageAlreadyRecordedError | GuidanceMessageNotFoundError | InterpretationAlreadyProposedError | InterpretationNotFoundError | InterpretationAlreadyAcceptedError | InterpretationAlreadyRejectedError | InterpretationSlotAlreadyAcceptedError | SourceSpanMismatchError | TopicNotSupportedError | TopicValueInvalidError | InterpretationNotAcceptedError | DecisionAlreadyExistsError | InterpretationAlreadyActivatedError | DecisionDefinitionNotActivatableError | DecisionSlotOccupiedError | DecisionPartitionLimitReachedError

        class ChangeSetDetails < Shared::Value
          def change_set_id: () -> String
        end

        class ActivationDependencyDetails < Shared::Value
          def change_set_id: () -> String
          def dependency_id: () -> String
        end

        class WorkItemDetails < Shared::Value
          def change_set_id: () -> String
          def work_item_id: () -> String
        end

        class DependencyDetails < Shared::Value
          def change_set_id: () -> String
          def dependency_id: () -> String
          def producer_work_item_id: () -> String
          def consumer_work_item_id: () -> String
        end

        class AttemptDetails < Shared::Value
          def change_set_id: () -> String
          def work_item_id: () -> String
          def attempt_id: () -> String
        end

        class CommandIdReusedDetails < Shared::Value
          def command_id: () -> String
          def existing_tool_name: () -> String
          def existing_input_digest: () -> String
          def requested_tool_name: () -> String
          def requested_input_digest: () -> String
        end

        class LeaseBusyDetails < Shared::Value
          def resource_key: () -> String
          def resource_key_hash: () -> String
          def lease_id: () -> String
          def owner_attempt_id: () -> String
          def owner_agent_id: () -> String
          def fencing_token: () -> Integer
          def expires_at: () -> String
        end

        class LeaseSetMismatchDetails < AttemptDetails
          def current_lease_set_id: () -> String
          def requested_lease_set_id: () -> String
        end

        class ResourceEvidenceConflictDetails < AttemptDetails
          def resource_key: () -> String
          def resource_key_hash: () -> String
          def current_base_blob_oid: () -> String?
          def requested_base_blob_oid: () -> String?
        end

        class WriteSetLimitDetails < AttemptDetails
          def current_resource_count: () -> Integer
          def requested_addition_count: () -> Integer
        end

        class LeaseSetExpiredDetails < AttemptDetails
          def resource_key_hash: () -> String
          def lease_id: () -> String
          def fencing_token: () -> Integer
          def expires_at: () -> String
        end

        class LeaseSetNotCurrentDetails < AttemptDetails
          def resource_key_hash: () -> String
          def expected_lease_id: () -> String
          def current_lease_id: () -> String?
          def expected_fencing_token: () -> Integer
          def current_fencing_token: () -> Integer
          def current_lease_set_id: () -> String?
          def current_attempt_id: () -> String?
          def current_expires_at: () -> String?
          def current_released_at: () -> String?
          def current_expired_at: () -> String?
        end

        class WriteSetReleasedDetails < AttemptDetails
          def released_at: () -> String
        end

        class LeaseSetSnapshotMismatchDetails < AttemptDetails
          def current_resource_key_hashes: () -> Array[String]
          def requested_resource_key_hashes: () -> Array[String]
        end

        class LeaseReferenceMismatchDetails < AttemptDetails
          def resource_key_hash: () -> String
          def current_lease_id: () -> String
          def requested_lease_id: () -> String
          def current_fencing_token: () -> Integer
          def requested_fencing_token: () -> Integer
        end

        class LeaseDeadlineNotExtendedDetails < AttemptDetails
          def current_expires_at: () -> String
          def requested_expires_at: () -> String
        end

        class MessageAlreadyRecordedDetails < Shared::Value
          def message_id: () -> String
        end

        class GuidanceMessageDetails < Shared::Value
          def message_id: () -> String
        end

        class InterpretationDetails < Shared::Value
          def interpretation_id: () -> String
        end

        class InterpretationMessageDetails < InterpretationDetails
          def message_id: () -> String
        end

        class InterpretationTerminalDetails < InterpretationDetails
          def event_id: () -> String
        end

        class InterpretationSlotDetails < InterpretationTerminalDetails
          def slot_digest: () -> String
        end

        class SourceSpanMismatchDetails < Shared::Value
          def message_id: () -> String
          def interpretation_id: () -> String
        end

        class TopicDetails < Shared::Value
          def topic_id: () -> String
        end

        class TopicValueDetails < Shared::Value
          def topic_id: () -> String
          def expected_schema: () -> String
          def supplied_schema: () -> String
        end

        class DecisionExistingDetails < Shared::Value
          def decision_id: () -> String
          def event_id: () -> String
          def event_type: () -> String
        end

        class InterpretationActivationDetails < InterpretationDetails
          def decision_id: () -> String
          def event_id: () -> String
        end

        class DecisionDefinitionIneligibleDetails < Shared::Value
          def reasons: () -> Array[String]
        end

        class DecisionSlotOccupiedDetails < Shared::Value
          def slot_id: () -> String
          def decision_id: () -> String
          def event_id: () -> String
        end

        class DecisionPartitionLimitDetails < Shared::Value
          def decision_id: () -> String
          def partition_count: () -> Integer
          def maximum_partition_count: () -> Integer
        end

        class ChangeSetError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> ChangeSetDetails
        end

        class ActivationDependencyError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> ActivationDependencyDetails
        end

        class WorkItemError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> WorkItemDetails
        end

        class DependencyError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> DependencyDetails
        end

        class AttemptError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> AttemptDetails
        end

        class CommandIdReusedError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> CommandIdReusedDetails
        end

        class LeaseBusyError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> LeaseBusyDetails
        end


        class LeaseSetMismatchError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> LeaseSetMismatchDetails
        end

        class ResourceEvidenceConflictError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> ResourceEvidenceConflictDetails
        end

        class WriteSetLimitError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> WriteSetLimitDetails
        end

        class LeaseSetExpiredError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> LeaseSetExpiredDetails
        end

        class LeaseSetNotCurrentError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> LeaseSetNotCurrentDetails
        end

        class WriteSetReleasedError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> WriteSetReleasedDetails
        end


        class LeaseSetSnapshotMismatchError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> LeaseSetSnapshotMismatchDetails
        end

        class LeaseReferenceMismatchError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> LeaseReferenceMismatchDetails
        end

        class LeaseDeadlineNotExtendedError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> LeaseDeadlineNotExtendedDetails
        end

        class MessageAlreadyRecordedError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> MessageAlreadyRecordedDetails
        end

        class GuidanceMessageNotFoundError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> GuidanceMessageDetails
        end

        class InterpretationAlreadyProposedError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> InterpretationDetails
        end

        class InterpretationNotFoundError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> InterpretationMessageDetails
        end

        class InterpretationAlreadyAcceptedError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> InterpretationTerminalDetails
        end

        class InterpretationAlreadyRejectedError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> InterpretationTerminalDetails
        end

        class InterpretationSlotAlreadyAcceptedError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> InterpretationSlotDetails
        end

        class SourceSpanMismatchError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> SourceSpanMismatchDetails
        end

        class TopicNotSupportedError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> TopicDetails
        end

        class TopicValueInvalidError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> TopicValueDetails
        end


        class InterpretationNotAcceptedError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> InterpretationDetails
        end

        class DecisionAlreadyExistsError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> DecisionExistingDetails
        end

        class InterpretationAlreadyActivatedError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> InterpretationActivationDetails
        end

        class DecisionDefinitionNotActivatableError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> DecisionDefinitionIneligibleDetails
        end

        class DecisionSlotOccupiedError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> DecisionSlotOccupiedDetails
        end

        class DecisionPartitionLimitReachedError < Shared::Value
          def code: () -> String
          def message: () -> String
          def details: () -> DecisionPartitionLimitDetails
        end
      end
    end
  end
end

module Coordinator
  module Write
    module Tasks
      module DomainErrorV1
        type domain_error = ChangeSetError | ActivationDependencyError | WorkItemError | DependencyError | AttemptError | CommandIdReusedError | LeaseBusyError | LeaseSetMismatchError | ResourceEvidenceConflictError | WriteSetLimitError | LeaseSetExpiredError | LeaseSetNotCurrentError | WriteSetReleasedError | LeaseSetSnapshotMismatchError | LeaseReferenceMismatchError | LeaseDeadlineNotExtendedError | MessageAlreadyRecordedError | GuidanceMessageNotFoundError | InterpretationAlreadyProposedError | InterpretationNotFoundError | InterpretationAlreadyAcceptedError | InterpretationAlreadyRejectedError | InterpretationSlotAlreadyAcceptedError | SourceSpanMismatchError | TopicNotSupportedError | TopicValueInvalidError | InterpretationNotAcceptedError | DecisionAlreadyExistsError | InterpretationAlreadyActivatedError | DecisionDefinitionNotActivatableError | DecisionSlotOccupiedError | DecisionPartitionLimitReachedError | DecisionPartitionCapacityReachedError | DecisionPartitionStateInvalidError | DecisionNotFoundError | DecisionNotActiveError | InterpretationNotACorrectionError | DecisionDefinitionNotCorrectableError | DecisionRevisionChangedError | DecisionSlotStateInvalidError | AgentChoiceAlreadyExistsError | StaleDecisionContextError | DecisionContextMismatchError | DecisionContextConflictError | DecisionContextLimitReachedError | UnsupportedDecisionContextError | AgentChoiceBlockedByDecisionError | AgentChoiceConfirmationRequiredError | AgentChoicePartitionSnapshotInvalidError | AgentChoiceDecisionHeadInvalidError | AgentChoiceUnresolvedHeadsError | CandidateAlreadyExistsError | CandidateHeadAlreadyRegisteredError | CandidateLeaseObservationsMismatchError | CandidateLeaseNotActiveScopeError | CandidateLeaseNotActiveError | CandidateUnauthorizedResourcesError | CandidateManifestBaseMismatchError

        class ChangeSetDetails < Shared::Value
          def change_set_id: () -> String
        end

        class ActivationDependencyDetails < Shared::Value
          def change_set_id: () -> String
          def dependency_id: () -> String
        end

        class WorkItemDetails < Shared::Value
          def change_set_id: () -> String
          def work_item_id: () -> String
        end

        class DependencyDetails < Shared::Value
          def change_set_id: () -> String
          def dependency_id: () -> String
          def producer_work_item_id: () -> String
          def consumer_work_item_id: () -> String
        end

        class AttemptDetails < Shared::Value
          def change_set_id: () -> String
          def work_item_id: () -> String
          def attempt_id: () -> String
        end

        class CommandIdReusedDetails < Shared::Value
          def command_id: () -> String
          def existing_tool_name: () -> String
          def existing_input_digest: () -> String
          def requested_tool_name: () -> String
          def requested_input_digest: () -> String
        end

        class LeaseBusyDetails < Shared::Value
          def resource_key: () -> String
          def resource_key_hash: () -> String
          def lease_id: () -> String
          def owner_attempt_id: () -> String
          def owner_agent_id: () -> String
          def fencing_token: () -> Integer
          def expires_at: () -> String
        end

        class LeaseSetMismatchDetails < AttemptDetails
          def current_lease_set_id: () -> String
          def requested_lease_set_id: () -> String
        end

        class ResourceEvidenceConflictDetails < AttemptDetails
          def resource_key: () -> String
          def resource_key_hash: () -> String
          def current_base_blob_oid: () -> String?
          def requested_base_blob_oid: () -> String?
        end

        class WriteSetLimitDetails < AttemptDetails
          def current_resource_count: () -> Integer
          def requested_addition_count: () -> Integer
        end

        class LeaseSetExpiredDetails < AttemptDetails
          def resource_key_hash: () -> String
          def lease_id: () -> String
          def fencing_token: () -> Integer
          def expires_at: () -> String
        end

        class LeaseSetNotCurrentDetails < AttemptDetails
          def resource_key_hash: () -> String
          def expected_lease_id: () -> String
          def current_lease_id: () -> String?
          def expected_fencing_token: () -> Integer
          def current_fencing_token: () -> Integer
          def current_lease_set_id: () -> String?
          def current_attempt_id: () -> String?
          def current_expires_at: () -> String?
          def current_released_at: () -> String?
          def current_expired_at: () -> String?
        end

        class WriteSetReleasedDetails < AttemptDetails
          def released_at: () -> String
        end

        class LeaseSetSnapshotMismatchDetails < AttemptDetails
          def current_resource_key_hashes: () -> Array[String]
          def requested_resource_key_hashes: () -> Array[String]
        end

        class LeaseReferenceMismatchDetails < AttemptDetails
          def resource_key_hash: () -> String
          def current_lease_id: () -> String
          def requested_lease_id: () -> String
          def current_fencing_token: () -> Integer
          def requested_fencing_token: () -> Integer
        end

        class LeaseDeadlineNotExtendedDetails < AttemptDetails
          def current_expires_at: () -> String
          def requested_expires_at: () -> String
        end


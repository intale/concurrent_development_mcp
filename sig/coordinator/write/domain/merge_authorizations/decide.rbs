module Coordinator
  module Write
    module Domain
      module MergeAuthorizations
        class Decide
          def initialize: (?stream_factory: StreamFactory) -> void
          def call: (
            command: Commands::RequestMergeAuthorization,
            evaluation: Write::MergeAuthorizations::EvaluationV1,
            authorization_id: String,
            input_digest: String,
            decision_digest: String,
            decided_at: String
          ) -> Dry::Monads::Result
        end
      end
    end
  end
end

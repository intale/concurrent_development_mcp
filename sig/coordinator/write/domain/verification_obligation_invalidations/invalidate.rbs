module Coordinator
  module Write
    module Domain
      module VerificationObligationInvalidations
        class Invalidate
          def initialize: (
            ?stream_factory: StreamFactory,
            ?digest_builder: Coordinator::Write::VerificationObligationInvalidations::DigestBuilder
          ) -> void
          def call: (
            state: State,
            command: Commands::InvalidateVerificationObligation,
            superseding_partition: Coordinator::Write::CandidateObligations::PersistedEventV1,
            invalidated_at: String
          ) -> Dry::Monads::Result
        end
      end
    end
  end
end

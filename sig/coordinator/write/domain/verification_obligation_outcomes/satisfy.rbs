module Coordinator::Write
  module Domain
    module VerificationObligationOutcomes
      class Satisfy
        @stream_factory: untyped

        def initialize: (?stream_factory: untyped) -> void

        def call: (state: untyped, command: untyped) -> untyped

        private

        def plan: (untyped obligation_id, untyped events) -> untyped

        def terminal_failure: (untyped state, untyped command) -> untyped
      end
    end
  end
end

module Coordinator
  module Write
    module Domain
      module Resources
        class Remove
          class DecisionV1 < Shared::Value
            def registration: () -> Events::ResourceIdentityV2::Registered
            def current_binding: () -> (Events::ResourceIdentityV2::Bound | Events::ResourceIdentityV2::Unbound)
            def unbinding: () -> Events::ResourceIdentityV2::Unbound?
            def events: () -> Array[Events::ResourceIdentityV2::Unbound]
            def outcome: () -> String
          end

          def call: (
            registration: Events::ResourceIdentityV2::Registered,
            current_binding: Events::ResourceIdentityV2::Bound | Events::ResourceIdentityV2::Unbound | nil,
            reason: String,
            removed_at: String
          ) -> Dry::Monads::Result
        end
      end
    end
  end
end

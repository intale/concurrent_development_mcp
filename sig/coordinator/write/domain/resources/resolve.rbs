module Coordinator
  module Write
    module Domain
      module Resources
        class Resolve
          class DecisionV1 < Shared::Value
            def registration: () -> Events::ResourceIdentityV2::Registered
            def binding: () -> Events::ResourceIdentityV2::Bound
            def events: () -> Array[Events::ResourceIdentityV2::Registered | Events::ResourceIdentityV2::Bound]
            def outcome: () -> String
          end

          def call: (
            identity: ResourceIdentityV1,
            proposed_resource_id: String,
            registration: Events::ResourceIdentityV2::Registered?,
            current_binding: Events::ResourceIdentityV2::Bound | Events::ResourceIdentityV2::Unbound | nil
          ) -> Dry::Monads::Result
        end
      end
    end
  end
end

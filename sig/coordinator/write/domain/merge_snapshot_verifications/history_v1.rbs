module Coordinator::Write::Domain::MergeSnapshotVerifications
  class HistoryV1 < Coordinator::Shared::Value
    Observation: untyped

    attr_reader snapshot: Coordinator::Write::Events::MergeSnapshotRegisteredV1?
    attr_reader snapshot_event: Coordinator::Write::EventReference?
    attr_reader submissions: Array[Coordinator::Write::MergeSnapshotVerifications::EvidenceObservationV1]
    attr_reader verified: Coordinator::Write::Events::MergeSnapshotVerifiedV1?
    attr_reader verified_event: Coordinator::Write::EventReference?

    def absent?: () -> bool
    def terminal?: () -> bool
    def duplicate?: (String verification_input_digest) -> bool
    def limit_reached?: () -> bool
  end
end

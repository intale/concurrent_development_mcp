module Coordinator
  module Write
    module Domain
      module Skills
        class State < Shared::Value
          type publication = Events::SkillRevisionPublishedV1 | Events::SkillRevisionPublishedV2

          def self.initial: () -> State
          def self.reduce: (Array[publication] events) -> State

          def publication: () -> publication?
          def current_revision: () -> Integer
        end
      end
    end
  end
end

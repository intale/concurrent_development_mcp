module Coordinator
  module Write
    module Domain
      module ChangeSets
        class State < Shared::Value
          def self.initial: () -> State
          def self.reduce: (Array[Events::Base] events) -> State
          def change_set_id: () -> String?
          def goal: () -> String?
          def status: () -> String
          def acceptance_criteria: () -> Array[String]
          def work_item_ids: () -> Array[String]
          def dependencies: () -> Array[Dependency]
          def dependency_satisfactions: () -> Array[DependencySatisfaction]
          def absent?: () -> bool
          def apply: (Events::Base event) -> State
          def dependency_satisfied?: (String dependency_id) -> bool
        end
      end
    end
  end
end

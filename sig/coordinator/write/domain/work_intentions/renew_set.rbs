module Coordinator
  module Write
    module Domain
      module WorkIntentions
        class RenewSet
          def initialize: (?stream_factory: StreamFactory) -> void
          def call: (
            attempt_state: Domain::Attempts::State,
            set_state: SetState,
            member_states: Array[State],
            command: Commands::RenewWorkIntentionSet,
            renewed_at: String,
            expires_at: String
          ) -> Dry::Monads::Result
        end
      end
    end
  end
end

    Verification: singleton(Coordinator::Write::ReleaseSets::VerificationFactV1)

    def preparation: () -> Coordinator::Write::ReleaseSets::PreparationFactV1?
    def integrations: () -> Array[Coordinator::Write::ReleaseSets::IntegrationFactV1]
    def verifications: () -> Array[Coordinator::Write::ReleaseSets::VerificationFactV1]

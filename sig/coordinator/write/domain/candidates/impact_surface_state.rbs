module Coordinator::Write
  module Domain
    module Candidates
      class ImpactSurfaceState < Coordinator::Shared::Value
        def submission: () -> Coordinator::Write::Events::CandidateSubmittedV1?
        def manifest: () -> Coordinator::Write::Events::CandidateChangeManifestCapturedV1?

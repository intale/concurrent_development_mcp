module Coordinator
  module Write
    module Domain
      module VerificationObligationWaivers
        class State < Shared::Value
          def self.initial: () -> State
          def obligation: () -> VerificationObligations::DefinitionV2?
          def obligation_event: () -> EventReference?
          def satisfied: () -> Events::VerificationObligationSatisfiedV2?
          def satisfied_event: () -> EventReference?
          def failed: () -> Events::VerificationObligationFailedV2?
          def failed_event: () -> EventReference?
          def waived: () -> Events::VerificationObligationWaivedV2?
          def waived_event: () -> EventReference?
          def invalidated: () -> Events::VerificationObligationInvalidatedV2?
          def invalidated_event: () -> EventReference?
          def absent?: () -> bool
          def status: () -> String
        end
      end
    end
  end
end

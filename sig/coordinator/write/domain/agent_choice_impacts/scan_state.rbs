module Coordinator
  module Write
    module Domain
      module AgentChoiceImpacts
        class ScanState < Shared::Value
          def self.initial: () -> ScanState
          def status: () -> String
          def scan_id: () -> String?
          def decision_change: () -> Coordinator::Write::AgentChoiceImpacts::DecisionChangeEvidenceV1?
          def started_event: () -> EventReference?
          def checkpoint_event: () -> EventReference?
          def from_position: () -> Integer?
          def to_position: () -> Integer?
          def page_size: () -> Integer?
          def page_count: () -> Integer
          def total_choice_count: () -> Integer
          def policy_version: () -> String?
          def skip_reason: () -> String?
          def absent?: () -> bool
          def running?: () -> bool
          def terminal?: () -> bool
        end
      end
    end
  end
end

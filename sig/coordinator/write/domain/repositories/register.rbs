module Coordinator
  module Write
    module Domain
      module Repositories
        class Register
          class DecisionV1 < Shared::Value
            Registration: untyped
            Plan: untyped

            def registration: () -> Events::RepositoryRegisteredV1
            def event_plan: () -> EventPlan?
            def outcome: () -> String
          end

          def initialize: (?stream_factory: StreamFactory) -> void
          def call: (registration_by_key: Events::RepositoryRegisteredV1?, registration_by_id: Events::RepositoryRegisteredV1?, command: Commands::RegisterRepository, registered_at: String) -> Dry::Monads::Result
        end
      end
    end
  end
end

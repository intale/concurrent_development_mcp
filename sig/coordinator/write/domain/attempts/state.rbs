module Coordinator
  module Write
    module Domain
      module Attempts
        class State < Shared::Value
          def self.initial: () -> State
          def self.reduce: (Array[Events::Base] events) -> State
          def attempt_id: () -> String?
          def change_set_id: () -> String?
          def work_item_id: () -> String?
          def agent_id: () -> String?
          def base_snapshots: () -> Array[RepositorySnapshotV1]
          def lease_set_id: () -> String?
          def lease_repository_id: () -> String?
          def lease_policy_version: () -> String?
          def lease_resources: () -> Array[LeaseReferenceV2]
          def lease_reserved_at: () -> String?
          def lease_renewed_at: () -> String?
          def lease_expires_at: () -> String?
          def lease_released_at: () -> String?
          def status: () -> String
          def selected_candidate_id: () -> String?
          def selected_candidate_event: () -> EventReference?
          def selected_candidate_checkpoint_kind: () -> String?
          def completed_at: () -> String?
          def absent?: () -> bool
          def apply: (Events::Base event) -> State
        end
      end
    end
  end
end

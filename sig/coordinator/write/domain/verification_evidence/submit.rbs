module Coordinator
  module Write
    module Domain
      module VerificationEvidence
        class Submit
          def initialize: (?stream_factory: StreamFactory, ?outcome_digest_builder: CompatibilityAssessments::OutcomeDigestBuilder) -> void
          def call: (
            state: State,
            command: Commands::SubmitCompatibilityAssessment,
            evidence_id: String,
            assessment_input_digest: String,
            evidence_event: EventReference,
            submitted_at: String
          ) -> Dry::Monads::Result
        end
      end
    end
  end
end

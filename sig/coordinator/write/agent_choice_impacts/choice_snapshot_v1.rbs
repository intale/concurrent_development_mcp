module Coordinator
  module Write
    module AgentChoiceImpacts
      class ChoiceSnapshotV1 < Shared::Value
        def choice_id: () -> String
        def recorded: () -> (Events::AgentChoiceRecordedV1 | Events::AgentChoiceRecordedV2)
        def recorded_event: () -> EventReference
        def accepted: () -> (Events::AgentChoiceAcceptedV1 | Events::AgentChoiceAcceptedV2)
        def accepted_event: () -> EventReference
        def invalidation: () -> (Events::AgentChoiceInvalidatedByDecisionV1 | Events::AgentChoiceInvalidatedByDecisionV2)?
        def invalidation_event: () -> EventReference?
      end
    end
  end
end

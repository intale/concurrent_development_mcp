module Coordinator
  module Write
    module CompatibilityAssessments
      class OutcomeDigestBuilder
        def initialize: (?canonical_json: Shared::CanonicalJson) -> void
        def satisfied: (obligation: VerificationObligations::DefinitionV2, selected_evidence: Array[EvidenceDecisionReferenceV1]) -> String
        def failed: (obligation: VerificationObligations::DefinitionV2, triggering_evidence: EvidenceDecisionReferenceV1) -> String

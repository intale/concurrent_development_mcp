module Coordinator
  module Write
    module CommandInputDocuments
      type value = CreateChangeSetV1 | CreateWorkItemV1 | DeclareWorkItemDependencyV1 | ActivateChangeSetV1 | AcquireWorkItemV1 | ReserveWriteSetV1 | ExpandWriteSetV1 | RenewLeaseSetV1 | ReleaseLeaseSetV1 | RecordGuidanceV1 | ProposeDecisionInterpretationV1 | AdjudicateDecisionInterpretationV1 | ActivateDecisionV1 | CorrectDecisionV1
      type digest_value = value | ExpireResourceLeaseV1

      class ActorV1 < Shared::Value
        def actor_kind: () -> String
        def actor_id: () -> String
      end

      class BaseV1 < Shared::Value
        def schema: () -> String
        def command_id: () -> String
      end

      class CreateChangeSetInputV1 < Shared::Value
        def actor: () -> ActorV1
        def change_set_id: () -> String
        def goal: () -> String
        def acceptance_criteria: () -> Array[String]
      end

      class CreateChangeSetV1 < BaseV1
        def tool_name: () -> String
        def input: () -> CreateChangeSetInputV1
      end

      class CreateWorkItemInputV1 < Shared::Value
        def actor: () -> ActorV1
        def change_set_id: () -> String
        def work_item_id: () -> String
        def repository_id: () -> String
        def goal: () -> String
        def acceptance_criteria: () -> Array[String]
      end

      class CreateWorkItemV1 < BaseV1
        def tool_name: () -> String
        def input: () -> CreateWorkItemInputV1
      end

      class DeclareWorkItemDependencyInputV1 < Shared::Value
        def actor: () -> ActorV1
        def change_set_id: () -> String
        def dependency_id: () -> String
        def producer_work_item_id: () -> String
        def consumer_work_item_id: () -> String
        def dependency_kind: () -> String
        def required_output: () -> RequiredOutput?
      end

      class DeclareWorkItemDependencyV1 < BaseV1
        def tool_name: () -> String
        def input: () -> DeclareWorkItemDependencyInputV1
      end

      class ActivateChangeSetInputV1 < Shared::Value
        def actor: () -> ActorV1
        def change_set_id: () -> String
      end

      class ActivateChangeSetV1 < BaseV1
        def tool_name: () -> String
        def input: () -> ActivateChangeSetInputV1
      end

      class RepositorySnapshotV1 < Shared::Value
        def repository_id: () -> String
        def object_format: () -> String
        def commit_oid: () -> String
      end

      class AcquireWorkItemInputV1 < Shared::Value
        def actor: () -> ActorV1
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
        def base_snapshots: () -> Array[RepositorySnapshotV1]
      end

      class AcquireWorkItemV1 < BaseV1
        def tool_name: () -> String
        def input: () -> AcquireWorkItemInputV1
      end

      class FileResourceV1 < Shared::Value
        def kind: () -> String
        def path: () -> String
        def base_blob_oid: () -> String?
        def resource_key: () -> String
        def resource_key_hash: () -> String
        def policy_version: () -> String
      end

      class ReserveWriteSetInputV1 < Shared::Value
        def actor: () -> ActorV1
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
        def repository_id: () -> String
        def base_commit_oid: () -> String
        def resources: () -> Array[FileResourceV1]
        def lease_duration_seconds: () -> Integer
      end

      class ReserveWriteSetV1 < BaseV1
        def tool_name: () -> String
        def input: () -> ReserveWriteSetInputV1
      end

      class ExpandWriteSetInputV1 < Shared::Value
        def actor: () -> ActorV1
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
        def lease_set_id: () -> String
        def repository_id: () -> String
        def base_commit_oid: () -> String
        def resources: () -> Array[FileResourceV1]
      end

      class ExpandWriteSetV1 < BaseV1
        def tool_name: () -> String
        def input: () -> ExpandWriteSetInputV1
      end

      class LeaseRenewalReferenceV1 < Shared::Value
        def resource_key_hash: () -> String
        def lease_id: () -> String
        def fencing_token: () -> Integer
      end

      class RenewLeaseSetInputV1 < Shared::Value
        def actor: () -> ActorV1
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
        def lease_set_id: () -> String
        def leases: () -> Array[LeaseRenewalReferenceV1]
        def lease_duration_seconds: () -> Integer
      end

      class RenewLeaseSetV1 < BaseV1
        def tool_name: () -> String
        def input: () -> RenewLeaseSetInputV1
      end

      class LeaseReleaseReferenceV1 < Shared::Value
        def resource_key_hash: () -> String
        def lease_id: () -> String
        def fencing_token: () -> Integer
      end

      class ReleaseLeaseSetInputV1 < Shared::Value
        def actor: () -> ActorV1
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
        def lease_set_id: () -> String
        def leases: () -> Array[LeaseReleaseReferenceV1]
      end

      class ReleaseLeaseSetV1 < BaseV1
        def tool_name: () -> String
        def input: () -> ReleaseLeaseSetInputV1
      end

      class GuidanceAnchorsV1 < Shared::Value
        def repository_ids: () -> Array[String]
        def change_set_id: () -> String?
        def work_item_id: () -> String?
        def attempt_id: () -> String?
      end

      class RecordGuidanceInputV1 < Shared::Value
        def actor: () -> ActorV1
        def message_id: () -> String
        def conversation_id: () -> String
        def source: () -> String
        def text: () -> String
        def anchors: () -> GuidanceAnchorsV1
      end

      class RecordGuidanceV1 < BaseV1
        def tool_name: () -> String
        def input: () -> RecordGuidanceInputV1
      end

      class ProposeDecisionInterpretationInputV1 < Shared::Value
        Ambiguity: singleton(Interpretations::InterpretationAmbiguityV1)

        def actor: () -> ActorV1
        def interpretation_id: () -> String
        def source_message_id: () -> String
        def source_span: () -> Interpretations::SourceSpanV1?
        def classifier: () -> Interpretations::ClassifierAttributionV1
        def proposed_decision: () -> Interpretations::SubmittedDecisionV1
        def ambiguities: () -> Array[Interpretations::InterpretationAmbiguityV1]
      end

      class ProposeDecisionInterpretationV1 < BaseV1
        def tool_name: () -> String
        def input: () -> ProposeDecisionInterpretationInputV1
      end

      class AdjudicateDecisionInterpretationInputV1 < Shared::Value
        def actor: () -> ActorV1
        def source_message_id: () -> String
        def interpretation_id: () -> String
        def action: () -> String
        def rationale: () -> Interpretations::AdjudicationRationaleV1
        def clarification: () -> Interpretations::AdjudicationClarificationV1?
      end

      class AdjudicateDecisionInterpretationV1 < BaseV1
        def tool_name: () -> String
        def input: () -> AdjudicateDecisionInterpretationInputV1
      end

      class ActivateDecisionInputV1 < Shared::Value
        def actor: () -> ActorV1
        def decision_id: () -> String
        def interpretation_id: () -> String
        def rationale: () -> Decisions::DecisionActivationRationaleV1
      end

      class ActivateDecisionV1 < BaseV1
        def tool_name: () -> String
        def input: () -> ActivateDecisionInputV1
      end

      class EventReferenceV1 < Shared::Value
        def event_id: () -> String
        def type: () -> String
        def stream_context: () -> String
        def stream_name: () -> String
        def stream_id: () -> String
        def stream_revision: () -> Integer
      end

      class CorrectDecisionInputV1 < Shared::Value
        def actor: () -> ActorV1
        def decision_id: () -> String
        def interpretation_id: () -> String
        def expected_head: () -> EventReferenceV1
        def rationale: () -> Decisions::DecisionCorrectionRationaleV1
      end

      class CorrectDecisionV1 < BaseV1
        def tool_name: () -> String
        def input: () -> CorrectDecisionInputV1
      end

      class ExpireResourceLeaseInputV1 < Shared::Value
        def actor: () -> ActorV1
        def resource_key_hash: () -> String
        def lease_id: () -> String
        def lease_set_id: () -> String
        def fencing_token: () -> Integer
        def expected_expires_at: () -> String
      end

      class ExpireResourceLeaseV1 < BaseV1
        def tool_name: () -> String
        def input: () -> ExpireResourceLeaseInputV1
      end
    end
  end
end

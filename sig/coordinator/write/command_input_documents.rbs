module Coordinator
  module Write
    module CommandInputDocuments
      type value = CreateChangeSetV1 | CreateWorkItemV1 | DeclareWorkItemDependencyV1 | ActivateChangeSetV1 | AcquireWorkItemV1 | ReserveWriteSetV1 | ExpandWriteSetV1 | RenewLeaseSetV1 | ReleaseLeaseSetV1 | RecordGuidanceV1 | ProposeDecisionInterpretationV1 | AdjudicateDecisionInterpretationV1 | ActivateDecisionV1 | CorrectDecisionV1 | RecordAgentChoiceV1 | SubmitCandidateV1 | SubmitCandidateImpactSurfaceV1 | ClaimVerificationObligationV1 | SubmitCompatibilityAssessmentV1 | WaiveVerificationObligationV1 | RegisterMergeSnapshotV1 | SubmitMergeSnapshotVerificationV1 | RequestMergeAuthorizationV1 | RecordMergeObservationV1
      type digest_value = value | ExpireResourceLeaseV1

      class ActorV1 < Shared::Value
        def actor_kind: () -> String
        def actor_id: () -> String
      end

      class BaseV1 < Shared::Value
        def schema: () -> String
        def command_id: () -> String
      end

      class CreateChangeSetInputV1 < Shared::Value
        def actor: () -> ActorV1
        def change_set_id: () -> String
        def goal: () -> String
        def acceptance_criteria: () -> Array[String]

module Coordinator
  module Write
    class CommandCompletionBuilder
      def initialize: (?persisted_events_contract: Contracts::PersistedEvents) -> void
      def create_change_set: (command: Commands::CreateChangeSet, input_digest: String, persisted_events: Array[PgEventstore::Event], completed_at: String) -> Events::CommandCompletedV1
      def work_item_create: (command: Commands::CreateWorkItem, input_digest: String, persisted_events: Array[PgEventstore::Event], completed_at: String) -> Events::CommandCompletedV1
      def work_item_dependency_declare: (command: Commands::DeclareWorkItemDependency, input_digest: String, persisted_events: Array[PgEventstore::Event], completed_at: String) -> Events::CommandCompletedV1
      def change_set_activate: (command: Commands::ActivateChangeSet, input_digest: String, persisted_events: Array[PgEventstore::Event], completed_at: String) -> Events::CommandCompletedV1
      def work_item_acquire: (command: Commands::AcquireWorkItem, input_digest: String, persisted_events: Array[PgEventstore::Event], completed_at: String) -> Events::CommandCompletedV1
      def write_set_reserve: (command: Commands::ReserveWriteSet, reservation: Events::WriteSetReservedV1, input_digest: String, persisted_events: Array[PgEventstore::Event], completed_at: String) -> Events::CommandCompletedV1
      def write_set_expand: (command: Commands::ExpandWriteSet, expansion: Events::WriteSetExpandedV1, input_digest: String, persisted_events: Array[PgEventstore::Event], completed_at: String) -> Events::CommandCompletedV1
      def lease_renew: (command: Commands::RenewLeaseSet, renewal: Events::WriteSetRenewedV1, input_digest: String, persisted_events: Array[PgEventstore::Event], completed_at: String) -> Events::CommandCompletedV1
      def lease_release: (command: Commands::ReleaseLeaseSet, release: Events::WriteSetReleasedV1, input_digest: String, persisted_events: Array[PgEventstore::Event], completed_at: String) -> Events::CommandCompletedV1
      def lease_expire_policy: (command: Commands::ExpireResourceLease, expiration: Events::ResourceLeaseExpiredV1, input_digest: String, persisted_events: Array[PgEventstore::Event], completed_at: String) -> Events::CommandCompletedV1
      def guidance_record: (command: Commands::RecordGuidance, input_digest: String, persisted_events: Array[PgEventstore::Event], completed_at: String) -> Events::CommandCompletedV1
      def decision_interpretation_propose: (command: Commands::ProposeDecisionInterpretation, proposal: Events::DecisionInterpretationProposedV1, input_digest: String, persisted_events: Array[PgEventstore::Event], completed_at: String) -> Events::CommandCompletedV1
      def decision_interpretation_adjudicate: (command: Commands::AdjudicateDecisionInterpretation, slot: Interpretations::InterpretationSlotV1?, input_digest: String, persisted_events: Array[PgEventstore::Event], completed_at: String) -> Events::CommandCompletedV1
      def decision_activate: (command: Commands::ActivateDecision, activation: Events::DecisionActivatedV1, partitions: Array[Decisions::DecisionPartitionReceiptV1], input_digest: String, persisted_events: Array[PgEventstore::Event], completed_at: String) -> Events::CommandCompletedV1
    end
  end
end

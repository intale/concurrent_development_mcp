module Coordinator::Write::CandidateObligations
  class NaturalKeyBuilder
    def initialize: (
      ?canonical_json: Coordinator::Shared::CanonicalJson,
      ?compound_marker_builder: Coordinator::Shared::CompoundMarkerBuilder
    ) -> void
    def call: (
      source: CandidateEvidenceV2,
      target: CandidateEvidenceV2,
      policy_partition_event: Coordinator::Write::EventReference,
      policy_head: Coordinator::Write::Decisions::DecisionHeadV1,
      rule_version: String

module Coordinator::Write
  module CandidateObligations
    class CandidateEvidenceV1 < Coordinator::Shared::Value
      def registration: () -> Coordinator::Write::Events::CandidateImpactSurfaceRegisteredV1
      def registration_event: () -> Coordinator::Write::EventReference

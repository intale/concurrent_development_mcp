module Coordinator::Write::Commands
  class CompleteChangeSet < Coordinator::Shared::Value
    def command_id: () -> String
    def actor: () -> Actor
    def change_set_id: () -> String
    def source_event: () -> Coordinator::Write::EventReference
    def release_set_id: () -> String?
    def rule_version: () -> String
    def decision_identity: () -> Coordinator::Write::ChangeSetCompletionDecisionIdentity
    def process_decision_marker: () -> String
    def process_decision_components: () -> Array[String]
  end
end

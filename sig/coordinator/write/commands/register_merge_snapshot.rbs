module Coordinator::Write
  module Commands
    class RegisterMergeSnapshot < Coordinator::Shared::Value
      attr_reader command_id: String
      attr_reader actor: Actor
      attr_reader merge_snapshot_id: String
      attr_reader repository_id: String
      attr_reader target_branch: String
      attr_reader object_format: String
      attr_reader target_base_commit_oid: String
      attr_reader ordered_candidates: Array[Coordinator::Write::MergeSnapshots::RequestedCandidateV1]
      attr_reader merge_commit_oid: String
      attr_reader producer: Coordinator::Write::MergeSnapshots::ProducerV1
      attr_reader run_id: String
      attr_reader produced_at: String
      attr_reader policy_version: String
    end
  end
end

module Coordinator
  module Write
    module Skills
      class SkillStateV1 < Shared::Value
        def self.initial: (skill_id: String) -> SkillStateV1
        def self.reduce: (Array[Events::Base] events) -> SkillStateV1?
        def skill_id: () -> String
        def name: () -> String?
        def scope: () -> String?
        def skill_revision_id: () -> String?
        def revision: () -> Integer?
        def content_digest: () -> String?
      end
    end
  end
end

module Coordinator::Write::ReleaseSets
  class IntegrationDigestDocumentV1 < Coordinator::Shared::Value
    def schema: () -> String
    def release_set_id: () -> String
    def release_digest: () -> String
    def repository_id: () -> String
    def member_position: () -> Integer
    def attempt_id: () -> String
    def attempt_number: () -> Integer
    def outcome: () -> String

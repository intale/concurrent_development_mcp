module Coordinator
  module Write
    class NextAction < Shared::Value
      type arguments = ChangeSetArguments | AttemptArguments | GuidanceArguments | InterpretationListArguments | DecisionArguments | AgentChoiceArguments | CandidateArguments | VerificationObligationArguments | MergeSnapshotArguments | DecisionResolutionArguments

      class ChangeSetArguments < Shared::Value
        def change_set_id: () -> String
      end

      class AttemptArguments < Shared::Value
        def change_set_id: () -> String
        def work_item_id: () -> String
        def attempt_id: () -> String
      end

      class GuidanceArguments < Shared::Value
        def message_id: () -> String
      end

      class InterpretationListArguments < Shared::Value
        def message_id: () -> String
      end

      class DecisionArguments < Shared::Value
        def decision_id: () -> String
      end

      class AgentChoiceArguments < Shared::Value
        def choice_id: () -> String
      end

      class CandidateArguments < Shared::Value
        def candidate_id: () -> String
      end

      class VerificationObligationArguments < Shared::Value
        def obligation_id: () -> String
      end

      class MergeSnapshotArguments < Shared::Value
        def merge_snapshot_id: () -> String
      end

      class DecisionResolutionArguments < Shared::Value
        def topic_id: () -> String
        def context: () -> DecisionContexts::QueryContextV1
      end

      def tool: () -> String
      def arguments: () -> arguments
    end
  end
end

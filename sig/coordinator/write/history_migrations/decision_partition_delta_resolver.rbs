module Coordinator
  module Write
    module HistoryMigrations
      class DecisionPartitionDeltaResolver
        def initialize: (event_store: EventStore, ?schema_registry: LegacyEventSchemaRegistry) -> void

        def call: (
          source_event: PgEventstore::Event,
          source_upper_position: Integer
        ) -> Dry::Monads::Result

        def membership: (
          source_event: PgEventstore::Event,
          source_upper_position: Integer,
          source_head: Decisions::DecisionHeadV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

module Coordinator
  module Write
    module HistoryMigrations
      class WorkIntentionContextResolver
        SOURCE_CLASSES: Hash[String, singleton(Events::Base)]
        SET_MEMBERSHIP_TYPES: Array[String]
        SET_MEMBERSHIP_MAXIMUM_COUNT: Integer

        def initialize: (
          event_store: EventStore,
          stream_identity_allocator: StreamIdentityAllocator,
          entity_reference_resolver: LegacyEntityReferenceResolver,
          ?repository_marker_builder: RepositoryMarkerBuilder,
          ?schema_registry: LegacyEventSchemaRegistry
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::Base
        ) -> Dry::Monads::Result
      end
    end
  end
end

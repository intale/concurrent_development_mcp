module Coordinator
  module Write
    module HistoryMigrations
      class TransformerRegistry
        def initialize: (
          ?schema_registry: EventSchemaRegistry | LegacyEventSchemaRegistry,
          repository_registered_v1: RepositoryRegisteredV1Transformer,
          guidance_message_v1: GuidanceMessageV1Transformer,
          change_set_v1: ChangeSetV1Transformer,
          work_item_v1: WorkItemV1Transformer,
          attempt_v1: AttemptV1Transformer,
          candidate_submission_v1: CandidateSubmissionV1Transformer,
          candidate_evidence_v1: CandidateEvidenceV1Transformer,
          candidate_head_v1: CandidateHeadV1Transformer,
          candidate_impact_v1: CandidateImpactV1Transformer,
          candidate_impact_scan_v1: CandidateImpactScanV1Transformer,
          interpretation_lifecycle_v1: InterpretationLifecycleV1Transformer,
          decision_lifecycle_v1: DecisionLifecycleV1Transformer,
          decision_relation_v1: DecisionRelationV1Transformer,
          agent_choice_v1: AgentChoiceV1Transformer,
          agent_choice_impact_v1: AgentChoiceImpactV1Transformer,
          agent_choice_impact_scan_v1: AgentChoiceImpactScanV1Transformer,
          coordination_task_submitted_v2: CoordinationTaskSubmittedV2Transformer,
          coordination_task_lifecycle: CoordinationTaskLifecycleTransformer,
          command_completed_v1: CommandCompletedV1Transformer,
          development_artifact_v1: DevelopmentArtifactV1Transformer,
          development_artifact_relation_v1: DevelopmentArtifactRelationV1Transformer,
          skill_revision_published_v2: SkillRevisionPublishedV2Transformer,
          merge_snapshot_v1: MergeSnapshotV1Transformer,
          merge_snapshot_verification_v1: MergeSnapshotVerificationV1Transformer,
          merge_authorization_v1: MergeAuthorizationV1Transformer,
          merge_observation_v1: MergeObservationV1Transformer
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer?,
          source_event: PgEventstore::Event
        ) -> Dry::Monads::Result
      end
    end
  end
end

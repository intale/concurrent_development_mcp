module Coordinator
  module Write
    module HistoryMigrations
      class LegacyTargetEventReferenceResolver
        PROCESS_RULE_VERSION: String

        def initialize: (
          event_store: EventStore,
          stream_identity_allocator: StreamIdentityAllocator,
          process_step_planner: Coordinator::Processes::ProcessStepPlanner,
          target_event_planner: TargetEventPlanner
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_reference: EventReference,
          target_stream_context: String,
          target_stream_name: String,
          identity_role: String,
          target_event_type: String,
          target_step_name: String
        ) -> Dry::Monads::Result

        def call_in_stream: (
          migration_id: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_reference: EventReference,
          target_stream: StreamReference,
          target_event_type: String,
          target_step_name: String
        ) -> Dry::Monads::Result
      end
    end
  end
end

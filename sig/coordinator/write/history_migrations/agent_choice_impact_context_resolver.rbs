module Coordinator
  module Write
    module HistoryMigrations
      class AgentChoiceImpactContextResolver
        def initialize: (
          event_store: EventStore,
          stream_identity_allocator: StreamIdentityAllocator,
          target_event_reference_resolver: LegacyTargetEventReferenceResolver,
          head_reference_resolver: DecisionHeadReferenceResolver,
          document_transformer: AgentChoiceDocumentTransformer,
          ?source_builder: AgentChoiceImpacts::DecisionChangeEvidenceBuilder,
          ?reconstructor: AgentChoiceImpacts::HistoricalContextReconstructor,
          ?assessment_contract: Contracts::AgentChoiceImpactAssessment,
          ?schema_registry: LegacyEventSchemaRegistry
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          assessment_event: PgEventstore::Event,
          assessment: Events::AgentChoiceImpactAssessedV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

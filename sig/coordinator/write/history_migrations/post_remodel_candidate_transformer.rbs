module Coordinator
  module Write
    module HistoryMigrations
      class PostRemodelCandidateTransformer
        def initialize: (
          context_resolver: PostRemodelCandidateContextResolver,
          stream_identity_allocator: StreamIdentityAllocator,
          compound_marker_builder: Coordinator::Shared::CompoundMarkerBuilder
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::CandidateAssignedToAttemptV1 | Events::CandidateAssignedToRepositoryV1 | Events::CandidateChangeManifestCapturedV2 | Events::CandidateCheckpointKindSelectedV1 | Events::CandidateCommitRangeDeclaredV1 | Events::CandidateCreatedV1 | Events::CandidateHeadRegisteredV2 | Events::CandidateSubmittedV3 | Events::CandidateTargetBranchSelectedV1 | Events::CandidateWorkIntentionSetAssignedV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

module Coordinator
  module Write
    module HistoryMigrations
      class TransformationErrorV1 < Shared::Value
        def code: () -> (
          :unsupported_source_contract |
          :invalid_source_event |
          :ambiguous_source_reference
        )
        def message: () -> String
        def event_type: () -> String
        def schema_version: () -> Integer?
        def source_event_id: () -> String
      end
    end
  end
end

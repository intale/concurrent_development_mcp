module Coordinator
  module Write
    module HistoryMigrations
      class PostRemodelCommandTaskTransformer
        COMMAND_TERMINALS: Array[singleton(Events::Base)]
        TASK_LIFECYCLE_STEPS: Hash[singleton(Events::Base), String]

        def initialize: (
          event_store: EventStore,
          stream_identity_allocator: StreamIdentityAllocator,
          entity_reference_resolver: LegacyEntityReferenceResolver,
          source_event_plan_resolver: MigrationSourceEventPlanResolver,
          command_input_rebinder: PostRemodelCommandInputRebinder,
          rejection_builder: LegacyCommandRejectionBuilder,
          marked_event_locator: LegacyMarkedEventLocator,
          ?request_marker: CommandLifecycle::RequestMarker,
          ?execution_lane: Tasks::ExecutionLane,
          ?tool_name_mapper: PostRemodelToolNameMapper,
          ?marker_codec: Shared::Markers::CodecV2,
          ?schema_registry: SourceEventSchemaRegistry
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::CommandRegisteredV1 | Events::CommandRejectedV1 | Events::CommandRejectedV2 | Events::CommandSucceededV1 | PostRemodelEvents::CoordinationTaskSubmittedV3 | Events::CoordinationTaskExecutionStartedV2 | Events::CoordinationTaskCancellationRequestedV2 | Events::CoordinationTaskCancelledV2 | Events::CoordinationTaskCompletedV3 | Events::CoordinationTaskFailedV2 | Events::ProcessStepPlannedV1
        ) -> Dry::Monads::Result

        private

        def migrated_dependency_id: (String, source_event: PgEventstore::Event, source_upper_position: Integer) -> Dry::Monads::Result
      end
    end
  end
end

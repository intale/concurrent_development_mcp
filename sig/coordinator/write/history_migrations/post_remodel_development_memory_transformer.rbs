module Coordinator
  module Write
    module HistoryMigrations
      class PostRemodelDevelopmentMemoryTransformer
        ARTIFACT_EVENTS: Array[singleton(Events::Base)]
        ARTIFACT_REFERENCE_STEPS: Hash[String, String]
        RELATION_TARGETS: Hash[String, Array[String]]

        def initialize: (
          event_store: EventStore,
          stream_identity_allocator: StreamIdentityAllocator,
          entity_reference_resolver: LegacyEntityReferenceResolver,
          target_event_reference_resolver: LegacyTargetEventReferenceResolver,
          guidance_identity_resolver: PostRemodelGuidanceIdentityResolver,
          guidance_anchor_resolver: PostRemodelGuidanceAnchorResolver,
          ?marker_builder: DevelopmentArtifacts::MarkerBuilder,
          ?schema_registry: EventSchemaRegistry
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::DevelopmentArtifactContentChangedV1 | Events::DevelopmentArtifactCreatedV1 | Events::DevelopmentArtifactKindChangedV1 | Events::DevelopmentArtifactLabelAddedV1 | Events::DevelopmentArtifactScopeChangedV1 | Events::DevelopmentArtifactSourceChangedV1 | Events::DevelopmentArtifactTitleChangedV1 | Events::DevelopmentArtifactObservationRecordedV1 | Events::DevelopmentArtifactObservationFactLinkedV1 | Events::DevelopmentArtifactRelationDeclaredV2 | Events::UserUtteranceForwardedByAgentV2 | Events::GuidanceMessageAnchoredV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

module Coordinator
  module Write
    module HistoryMigrations
      class ReleaseSetLegacyDigestBuilder
        DOCUMENTS: Hash[Symbol, [untyped, String]]

        def initialize: (?canonical_json: Shared::CanonicalJson) -> void
        def call: (
          :release kind,
          release_set_id: String,
          change_set_id: String,
          ordered_members: Array[ReleaseSets::MemberEvidenceV1],
          policy_version: String
        ) -> String
                | (
          :integration kind,
          release_set_id: String,
          release_digest: String,
          repository_id: String,
          member_position: Integer,
          attempt_id: String,
          attempt_number: Integer,
          outcome: String,
          merge_observation_event: EventReference?,
          observation_digest: String?,
          failure: ReleaseSets::IntegrationFailureV1?,
          policy_version: String
        ) -> String
                | (
          :verification kind,
          release_set_id: String,
          release_digest: String,
          attempt_number: Integer,
          integration_events: Array[EventReference],
          evidence: ReleaseSets::VerificationEvidenceV1,
          policy_version: String
        ) -> String
                | (
          :activation kind,
          release_set_id: String,
          release_digest: String,
          verification_event: EventReference,
          verification_digest: String,
          activation_point: ReleaseSets::ActivationPointV1,
          policy_version: String
        ) -> String
                | (
          :completion kind,
          release_set_id: String,
          release_digest: String,
          outcome: String,
          source_event: EventReference,
          compensation_evidence: Array[ReleaseSets::CompensationEvidenceV1],
          rule_version: String
        ) -> String
      end
    end
  end
end

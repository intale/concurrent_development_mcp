module Coordinator
  module Write
    module HistoryMigrations
      class LegacyWorkIntentionInputContextResolver
        def initialize: (
          event_store: EventStore,
          context_resolver: WorkIntentionContextResolver,
          post_remodel_context_resolver: PostRemodelWorkIntentionContextResolver,
          ?schema_registry: SourceEventSchemaRegistry
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          attempt_id: String,
          lease_set_id: String
        ) -> Dry::Monads::Result
      end
    end
  end
end

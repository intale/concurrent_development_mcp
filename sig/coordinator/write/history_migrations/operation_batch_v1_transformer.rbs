module Coordinator
  module Write
    module HistoryMigrations
      class OperationBatchV1Transformer
        def initialize: (
          context_resolver: OperationBatchContextResolver,
          target_event_reference_resolver: LegacyTargetEventReferenceResolver,
          target_plan_builder: TargetPlanBuilder,
          ?request_marker: CommandLifecycle::RequestMarker,
          ?rejection_retryability: LegacyCommandRejectionRetryability,
          ?manifest_builder: OperationBatches::ManifestBuilder
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer?,
          source_event: PgEventstore::Event,
          source_payload: Events::Base
        ) -> Dry::Monads::Result
      end
    end
  end
end

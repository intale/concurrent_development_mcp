module Coordinator
  module Write
    module HistoryMigrations
      class VerificationObligationContextResolver
        def initialize: (
          event_store: EventStore,
          stream_identity_allocator: StreamIdentityAllocator,
          entity_reference_resolver: LegacyEntityReferenceResolver,
          candidate_subject_transformer: CandidateSubjectV1Transformer,
          policy_transformer: VerificationPolicyV1Transformer,
          partition_reference_resolver: DecisionPartitionEventReferenceResolver,
          target_event_reference_resolver: LegacyTargetEventReferenceResolver,
          compound_marker_builder: Shared::CompoundMarkerBuilder,
          ?matcher: CandidateObligations::Matcher,
          ?schema_registry: LegacyEventSchemaRegistry
        ) -> void

        def from_creation: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_creation: Events::VerificationObligationCreatedV1
        ) -> Dry::Monads::Result

        def from_stream: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event
        ) -> Dry::Monads::Result

        def load_reference: (
          source_event: PgEventstore::Event,
          source_upper_position: Integer,
          source_reference: EventReference
        ) -> Dry::Monads::Result

        def target_reference: (
          migration_id: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_reference: EventReference,
          target_stream: StreamReference,
          target_event_type: String,
          target_step_name: String
        ) -> Dry::Monads::Result

        def partition_reference: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_reference: EventReference
        ) -> Dry::Monads::Result
      end
    end
  end
end

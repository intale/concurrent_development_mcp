module Coordinator
  module Write
    module HistoryMigrations
      class DevelopmentArtifactV1Transformer
        def initialize: (
          context_resolver: DevelopmentArtifactContextResolver,
          target_plan_builder: TargetPlanBuilder,
          target_event_reference_resolver: LegacyTargetEventReferenceResolver,
          ?state_transition: DevelopmentArtifactStateTransition,
          ?marker_builder: DevelopmentArtifacts::MarkerBuilder
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: LegacyEvents::DevelopmentArtifactCapturedV2 |
                          LegacyEvents::DevelopmentArtifactObservedV1 |
                          LegacyEvents::DevelopmentArtifactClassificationCorrectedV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

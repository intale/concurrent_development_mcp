module Coordinator
  module Write
    module HistoryMigrations
      class CandidateImpactV1Transformer
        def initialize: (
          context_resolver: CandidateContextResolver,
          stream_identity_allocator: StreamIdentityAllocator,
          target_event_reference_resolver: LegacyTargetEventReferenceResolver,
          index_marker_builder: Candidates::ImpactIndexMarkerBuilder
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::CandidateImpactSurfaceDerivedV1 | Events::CandidateImpactSurfaceRegisteredV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

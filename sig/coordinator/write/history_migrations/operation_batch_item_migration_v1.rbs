module Coordinator
  module Write
    module HistoryMigrations
      class OperationBatchItemMigrationV1 < Shared::Value
        type input = CommandInputDocuments::PublishSkillRevisionV2 | CommandInputDocuments::CaptureDevelopmentArtifactV2 | CommandInputDocuments::DeclareDevelopmentArtifactRelationV1

        def source_item: () -> (LegacyCommandInputDocuments::OperationBatchItemV1 | OperationBatches::ItemV1)
        def target_item: () -> OperationBatches::ItemV2
        def target_command_stream: () -> StreamReference
        def source_completion_event: () -> PgEventstore::Event?
        def encoded_byte_size: () -> Integer
        def index: () -> Integer
        def command_id: () -> String
        def request_id: () -> (String | Integer)
        def canonical_input_digest: () -> String
        def submitted_input: () -> input
        def actor: () -> Commands::Actor
      end
    end
  end
end

module Coordinator
  module Write
    module HistoryMigrations
      class MergeSnapshotMigrationContextV1 < Shared::Value
        def source_registration: () -> Events::MergeSnapshotRegisteredV1
        def source_registration_event: () -> PgEventstore::Event
        def target_registration_event: () -> EventReference?
        def snapshot_stream: () -> StreamReference
        def merge_snapshot_id: () -> String
        def repository_id: () -> String
        def candidate_contexts: () -> Array[CandidateContextV1]
        def target_candidate_members: () -> Array[MergeSnapshots::CandidateMemberV1]

        def ordered_candidate_ids: () -> Array[String]
        def source_registration_reference: () -> EventReference
        def target_state: (snapshot_digest: String) -> MergeSnapshots::StateV2
        def target_registration_event!: () -> EventReference
        def source_state_matches?: (MergeSnapshots::StateV2 state) -> bool
        def markers: () -> Array[String]
      end
    end
  end
end

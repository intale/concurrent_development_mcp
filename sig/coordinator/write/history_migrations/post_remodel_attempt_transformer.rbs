module Coordinator
  module Write
    module HistoryMigrations
      class PostRemodelAttemptTransformer
        def initialize: (
          stream_identity_allocator: StreamIdentityAllocator,
          entity_reference_resolver: LegacyEntityReferenceResolver
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::AttemptAbandonedV3 | Events::AttemptAssignedToAgentV1 | Events::AttemptAssignedToWorkItemV1 | Events::AttemptAuthorizedV2 | Events::AttemptBaseSnapshotRecordedV1 | Events::AttemptCompletedV2 | Events::AttemptStartedV2
        ) -> Dry::Monads::Result
      end
    end
  end
end

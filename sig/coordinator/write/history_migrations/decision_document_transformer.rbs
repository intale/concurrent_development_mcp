module Coordinator
  module Write
    module HistoryMigrations
      class DecisionDocumentTransformer
        SCOPE_TARGETS: Hash[Symbol, [String, String, String]]
        STREAM_TARGETS: Hash[[String, String], String]

        def initialize: (
          entity_reference_resolver: LegacyEntityReferenceResolver,
          ?canonical_json: CanonicalJson,
          ?marker_component_builder: Shared::CanonicalMarkerComponentBuilder,
          ?compound_marker_builder: Shared::CompoundMarkerBuilder
        ) -> void

        def proposed_decision: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          proposed_decision: Interpretations::ProposedDecisionV1
        ) -> Dry::Monads::Result

        def definition: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          definition: Decisions::DecisionDefinitionV1
        ) -> Dry::Monads::Result

        def slot_document: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          document: Decisions::DecisionSlotDocumentV1
        ) -> Dry::Monads::Result

        def interpretation_slot: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          slot: Interpretations::InterpretationSlotV1,
          source_message_id: String
        ) -> Dry::Monads::Result
      end
    end
  end
end

    module HistoryMigrations
      class DependencyWaveClassifier
        CREATION_WAVE: Integer
        DEFINITION_WAVE: Integer
        RELATION_WAVE: Integer
        TERMINAL_WAVE: Integer
        RELATION_PATTERNS: Array[String]
        TERMINAL_PATTERNS: Array[String]

        def call: (
          target_event_type: String,
          target_revision: Integer,
          ?previous_wave: Integer?

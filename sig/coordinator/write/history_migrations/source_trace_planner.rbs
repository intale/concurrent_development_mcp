module Coordinator
  module Write
    module HistoryMigrations
      class SourceTracePlanner
        MARKER_PURPOSE: String

        def initialize: (
          event_store: EventStore,
          ?natural_key_registry: NaturalKeys::Registry,
          ?marker_codec: Shared::Markers::CodecV2,
          ?id_generator: Shared::IdGenerator,
          ?event_factory: EventFactory,
          ?schema_registry: EventSchemaRegistry,
          ?stream_factory: StreamFactory
        ) -> void

        def call: (
          migration_id: String,
          source_event: PgEventstore::Event,
          target_plans: Array[TargetEventPlanV1]
        ) -> Dry::Monads::Result

        def causal_parent: (
          migration_id: String,
          source_event: PgEventstore::Event
        ) -> Dry::Monads::Result

        def find: (
          migration_id: String,
          source_event_id: String
        ) -> Dry::Monads::Result
      end
    end
  end
end

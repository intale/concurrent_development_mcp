module Coordinator
  module Write
    module HistoryMigrations
      class DevelopmentArtifactContextResolver
        SOURCE_TYPES: Hash[String, singleton(Events::Base)]
        OBSERVATION_TYPES: Array[String]
        SOURCE_HISTORY_PAGE_SIZE: Integer

        def initialize: (
          event_store: EventStore,
          stream_identity_allocator: StreamIdentityAllocator,
          ?state_transition: DevelopmentArtifactStateTransition,
          ?schema_registry: LegacyEventSchemaRegistry
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: LegacyEvents::DevelopmentArtifactCapturedV2 |
                          LegacyEvents::DevelopmentArtifactObservedV1 |
                          LegacyEvents::DevelopmentArtifactClassificationCorrectedV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

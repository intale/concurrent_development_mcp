module Coordinator
  module Write
    module HistoryMigrations
      class PostRemodelGuidanceIdentityResolver
        def initialize: (
          event_store: EventStore,
          stream_identity_allocator: StreamIdentityAllocator,
          ?schema_registry: SourceEventSchemaRegistry
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_conversation_id: String,
          source_message_id: String
        ) -> Dry::Monads::Result
      end
    end
  end
end

module Coordinator
  module Write
    module HistoryMigrations
      class WorkItemV1Transformer
        def initialize: (
          stream_identity_allocator: StreamIdentityAllocator,
          entity_reference_resolver: LegacyEntityReferenceResolver,
          marked_event_locator: LegacyMarkedEventLocator,
          target_event_reference_resolver: LegacyTargetEventReferenceResolver,
          ?schema_registry: LegacyEventSchemaRegistry
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::WorkItemCreatedV1 | Events::WorkItemAddedToChangeSetV1 | Events::WorkItemDependencyDeclaredV1 | Events::WorkItemDependencySatisfiedV1 | Events::WorkItemMadeReadyV1 | Events::WorkItemAcquiredV1 | Events::WorkItemRequeuedV1 | Events::WorkItemCandidateSelectedV1 | Events::WorkItemCompletedV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

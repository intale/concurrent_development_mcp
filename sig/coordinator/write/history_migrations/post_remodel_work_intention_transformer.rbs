module Coordinator
  module Write
    module HistoryMigrations
      class PostRemodelWorkIntentionTransformer
        def initialize: (
          context_resolver: PostRemodelWorkIntentionContextResolver,
          ?repository_marker_builder: RepositoryMarkerBuilder
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::WorkIntentionSetCreatedV1 | Events::WorkIntentionAddedToSetV1 | Events::ResourceWorkIntentionDeclaredV1 | Events::ResourceWorkIntentionRenewedV1 | Events::ResourceWorkIntentionWithdrawnV1 | Events::ResourceWorkIntentionExpiredV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

module Coordinator
  module Write
    module HistoryMigrations
      class AgentChoiceDecisionChangeTransformer
        PROCESS_RULE_VERSION: String
        TARGET_STEPS: Hash[String, String]

        def initialize: (
          event_store: EventStore,
          head_reference_resolver: DecisionHeadReferenceResolver,
          document_transformer: DecisionDocumentTransformer,
          partition_identity_mapper: DecisionPartitionIdentityMapper,
          process_step_planner: Coordinator::Processes::ProcessStepPlanner,
          ?source_builder: AgentChoiceImpacts::DecisionChangeEvidenceBuilder,
          ?schema_registry: LegacyEventSchemaRegistry,
          ?canonical_json: CanonicalJson
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          evidence: AgentChoiceImpacts::DecisionChangeEvidenceV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

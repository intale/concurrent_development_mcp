module Coordinator
  module Write
    module HistoryMigrations
      class LegacyCoordinationTaskSubmissionResolver
        def initialize: (
          event_store: EventStore,
          command_event_locator: LegacyCommandEventLocator,
          ?schema_registry: LegacyEventSchemaRegistry,
          ?canonical_json: Shared::CanonicalJson
        ) -> void

        def call: (
          source_event: PgEventstore::Event,
          source_upper_position: Integer?
        ) -> Dry::Monads::Result

        def for_completion: (
          source_event: PgEventstore::Event,
          source_upper_position: Integer?,
          command_id: String
        ) -> Dry::Monads::Result
      end
    end
  end
end

module Coordinator
  module Write
    module HistoryMigrations
      class AgentChoiceImpactScanContextResolver
        def initialize: (
          event_store: EventStore,
          stream_identity_allocator: StreamIdentityAllocator,
          decision_change_transformer: AgentChoiceDecisionChangeTransformer,
          ?schema_registry: LegacyEventSchemaRegistry
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::AgentChoiceImpactScanStartedV1 |
                          Events::AgentChoiceImpactScanProgressedV1 |
                          Events::AgentChoiceImpactScanSkippedV1 |
                          Events::AgentChoiceImpactScanCompletedV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

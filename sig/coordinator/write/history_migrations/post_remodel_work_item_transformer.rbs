module Coordinator
  module Write
    module HistoryMigrations
      class PostRemodelWorkItemTransformer
        SOURCE_REFERENCE_STEPS: Hash[String, String]

        def initialize: (
          stream_identity_allocator: StreamIdentityAllocator,
          entity_reference_resolver: LegacyEntityReferenceResolver,
          target_event_reference_resolver: LegacyTargetEventReferenceResolver
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::WorkItemAcquiredV2 | Events::WorkItemCandidateSelectedV2 | Events::WorkItemCompletedV2 | Events::WorkItemDependencySatisfiedV2 | Events::WorkItemMadeReadyV2 | Events::WorkItemRequeuedV2
        ) -> Dry::Monads::Result
      end
    end
  end
end

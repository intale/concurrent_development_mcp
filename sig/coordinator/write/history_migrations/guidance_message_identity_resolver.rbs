module Coordinator
  module Write
    module HistoryMigrations
      class GuidanceMessageIdentityResolver
        SOURCE_TYPES: Array[singleton(Events::UserUtteranceRecordedV1) | singleton(Events::UserUtteranceForwardedByAgentV1)]

        def initialize: (
          event_store: EventStore,
          ?schema_registry: LegacyEventSchemaRegistry
        ) -> void

        def call: (
          source_event: PgEventstore::Event,
          source_upper_position: Integer,
          source_reference: EventReference,
          source_message_id: String
        ) -> Dry::Monads::Result
      end
    end
  end
end

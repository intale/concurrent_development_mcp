module Coordinator
  module Write
    module HistoryMigrations
      class TargetPlanWaveSelector
        def initialize: (
          event_store: EventStore,
          ?schema_registry: EventSchemaRegistry,
          ?marker_codec: Shared::Markers::CodecV2
        ) -> void

        def call: (
          migration_id: String,
          source_event: PgEventstore::Event,
          transformed_facts: Array[TransformedFactV1],
          dependency_wave: Integer
        ) -> Dry::Monads::Result

        def find_complete: (
          migration_id: String,
          source_event: PgEventstore::Event,
          transformed_facts: Array[TransformedFactV1]
        ) -> Dry::Monads::Result

        def includes_wave?: (
          migration_id: String,
          source_event: PgEventstore::Event,
          dependency_wave: Integer
        ) -> Dry::Monads::Result
      end
    end
  end
end

module Coordinator
  module Write
    module HistoryMigrations
      class VerificationObligationValidityScanContextResolver
        def initialize: (
          event_store: EventStore,
          stream_identity_allocator: StreamIdentityAllocator,
          entity_reference_resolver: LegacyEntityReferenceResolver,
          partition_reference_resolver: DecisionPartitionEventReferenceResolver,
          target_event_reference_resolver: LegacyTargetEventReferenceResolver,
          ?schema_registry: LegacyEventSchemaRegistry
        ) -> void

        def from_started: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_started: Events::VerificationObligationValidityScanStartedV1
        ) -> Dry::Monads::Result

        def from_stream: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event
        ) -> Dry::Monads::Result

        def load_reference: (
          source_event: PgEventstore::Event,
          source_upper_position: Integer,
          source_reference: EventReference
        ) -> Dry::Monads::Result

        def target_reference: (
          migration_id: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_reference: EventReference,
          target_stream: StreamReference,
          target_event_type: String,
          target_step_name: String
        ) -> Dry::Monads::Result
      end
    end
  end
end

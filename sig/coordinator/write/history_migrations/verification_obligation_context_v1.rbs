module Coordinator
  module Write
    module HistoryMigrations
      class VerificationObligationContextV1 < Shared::Value
        def source_creation: () -> Events::VerificationObligationCreatedV1
        def source_creation_event: () -> PgEventstore::Event
        def target_creation_event: () -> EventReference?
        def target_stream: () -> StreamReference
        def obligation_id: () -> String
        def change_set_id: () -> String
        def source_candidate: () -> CandidateSubjectMigrationV1
        def target_candidate: () -> CandidateSubjectMigrationV1
        def policy: () -> CandidateObligations::ImpactPolicyEvidenceV1
        def natural_key_marker: () -> String
        def source_creation_reference: () -> EventReference
        def scope_markers: () -> Array[String]
        def markers: (?status: String?) -> Array[String]
      end
    end
  end
end

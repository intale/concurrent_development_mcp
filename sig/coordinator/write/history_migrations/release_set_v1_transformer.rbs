module Coordinator
  module Write
    module HistoryMigrations
      class ReleaseSetV1Transformer
        RELEASE_REFERENCE_TARGETS: Hash[String, Array[String]]

        def initialize: (
          event_store: EventStore,
          context_resolver: ReleaseSetContextResolver,
          ?digest_builder: ReleaseSetLegacyDigestBuilder,
          ?schema_registry: LegacyEventSchemaRegistry
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::Base
        ) -> Dry::Monads::Result
      end
    end
  end
end

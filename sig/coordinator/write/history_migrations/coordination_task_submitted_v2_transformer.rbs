module Coordinator
  module Write
    module HistoryMigrations
      class CoordinationTaskSubmittedV2Transformer
        def initialize: (
          stream_identity_allocator: StreamIdentityAllocator,
          submission_resolver: LegacyCoordinationTaskSubmissionResolver,
          command_input_rebinder: PostRemodelCommandInputRebinder,
          operation_batch_context_resolver: OperationBatchContextResolver,
          ?command_input_loader: LegacyCommandInputLoader,
          ?manifest_builder: OperationBatches::ManifestBuilder,
          ?request_marker: CommandLifecycle::RequestMarker,
          ?execution_lane: Tasks::ExecutionLane
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer?,
          source_event: PgEventstore::Event,
          source_payload: LegacyEvents::CoordinationTaskSubmittedV2
        ) -> Dry::Monads::Result
      end
    end
  end
end

module Coordinator
  module Write
    module HistoryMigrations
      class CoordinationTaskSubmittedV2Transformer
        def initialize: (
          stream_identity_allocator: StreamIdentityAllocator,
          command_event_locator: LegacyCommandEventLocator,
          ?command_input_rebinder: CommandInputRebinder,
          ?request_id_mapper: LegacyRequestIdMapper,
          ?request_marker: CommandLifecycle::RequestMarker,
          ?execution_lane: Tasks::ExecutionLane
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer?,
          source_event: PgEventstore::Event,
          source_payload: LegacyEvents::CoordinationTaskSubmittedV2
        ) -> Dry::Monads::Result
      end
    end
  end
end

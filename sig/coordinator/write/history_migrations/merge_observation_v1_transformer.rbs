module Coordinator
  module Write
    module HistoryMigrations
      class MergeObservationV1Transformer
        def initialize: (
          context_resolver: MergeSnapshotContextResolver,
          document_transformer: MergeAuthorizationDocumentTransformer,
          reference_resolver: MergeHistoryReferenceResolver
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::MergeObservedV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

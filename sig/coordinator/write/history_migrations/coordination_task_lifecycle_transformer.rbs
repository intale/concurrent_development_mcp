module Coordinator
  module Write
    module HistoryMigrations
      class CoordinationTaskLifecycleTransformer
        def initialize: (
          stream_identity_allocator: StreamIdentityAllocator,
          ?rejection_retryability: LegacyCommandRejectionRetryability,
          ?task_failure_mapper: LegacyTaskFailureMapper
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer?,
          source_event: PgEventstore::Event,
          source_payload: LegacyEvents::coordination_task_lifecycle
        ) -> Dry::Monads::Result
      end
    end
  end
end

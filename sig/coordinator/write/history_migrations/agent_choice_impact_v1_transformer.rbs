module Coordinator
  module Write
    module HistoryMigrations
      class AgentChoiceImpactV1Transformer
        ASSESSMENT_STEP: String
        ACCEPTED_SOURCE_STEP: String
        DECISION_SOURCE_STEP: String
        INVALIDATION_STEP: String

        def initialize: (
          event_store: EventStore,
          context_resolver: AgentChoiceImpactContextResolver,
          target_event_reference_resolver: LegacyTargetEventReferenceResolver,
          ?marker_builder: AgentChoiceImpacts::AssessmentMarkerBuilder,
          ?schema_registry: LegacyEventSchemaRegistry
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::AgentChoiceImpactAssessedV1 | Events::AgentChoiceInvalidatedByDecisionV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

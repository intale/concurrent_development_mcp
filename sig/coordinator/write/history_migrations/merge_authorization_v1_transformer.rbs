module Coordinator
  module Write
    module HistoryMigrations
      class MergeAuthorizationV1Transformer
        def initialize: (
          context_resolver: MergeSnapshotContextResolver,
          document_transformer: MergeAuthorizationDocumentTransformer,
          stream_identity_allocator: StreamIdentityAllocator
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::MergeAuthorizationGrantedV1 | Events::MergeAuthorizationDeniedV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

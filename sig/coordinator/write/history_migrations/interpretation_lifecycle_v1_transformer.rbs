module Coordinator
  module Write
    module HistoryMigrations
      class InterpretationLifecycleV1Transformer
        def initialize: (
          context_resolver: InterpretationContextResolver,
          document_transformer: DecisionDocumentTransformer
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::DecisionInterpretationProposedV1 |
                          Events::DecisionClarificationRequiredV1 |
                          Events::DecisionInterpretationAcceptedV1 |
                          Events::DecisionInterpretationRejectedV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

module Coordinator
  module Write
    module HistoryMigrations
      class MigrationSnapshotV1 < Shared::Value
        attr_reader migration_id: String
        attr_reader source_config_name: String
        attr_reader target_config_name: String
        attr_reader source_upper_position: Integer?
        attr_reader page_size: Integer
        attr_reader next_from_position: Integer
        attr_reader plan_completed: bool
        attr_reader application_dependency_wave: Integer
        attr_reader application_next_from_position: Integer
        attr_reader completed: bool
        attr_reader abandoned: bool
        attr_reader checkpoint_event: PgEventstore::Event
        attr_reader latest_revision: Integer
        attr_reader source_after_position: Integer?
        attr_reader source_command_ids: Array[String]
        def source_from_position: () -> Integer

        def plan_completed?: () -> bool
        def completed?: () -> bool
        def abandoned?: () -> bool
      end
    end
  end
end

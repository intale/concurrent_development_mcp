module Coordinator
  module Write
    module HistoryMigrations
      class AttemptV1Transformer
        def initialize: (
          stream_identity_allocator: StreamIdentityAllocator,
          entity_reference_resolver: LegacyEntityReferenceResolver
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::AttemptAuthorizedV1 | Events::AttemptStartedV1 | Events::AttemptCompletedV1 | Events::AttemptAbandonedV2
        ) -> Dry::Monads::Result
      end
    end
  end
end

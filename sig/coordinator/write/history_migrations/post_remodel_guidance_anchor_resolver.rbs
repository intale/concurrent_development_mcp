module Coordinator
  module Write
    module HistoryMigrations
      class PostRemodelGuidanceAnchorResolver
        def initialize: (
          event_store: EventStore,
          entity_reference_resolver: LegacyEntityReferenceResolver,
          ?schema_registry: SourceEventSchemaRegistry
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_conversation_id: String,
          source_message_id: String,
          anchor_kind: String,
          source_anchor_id: String
        ) -> Dry::Monads::Result
      end
    end
  end
end

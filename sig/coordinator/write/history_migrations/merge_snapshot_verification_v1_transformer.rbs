module Coordinator
  module Write
    module HistoryMigrations
      class MergeSnapshotVerificationV1Transformer
        def initialize: (
          event_store: EventStore,
          context_resolver: MergeSnapshotContextResolver,
          stream_identity_allocator: StreamIdentityAllocator,
          target_event_reference_resolver: LegacyTargetEventReferenceResolver,
          ?schema_registry: LegacyEventSchemaRegistry
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: Events::MergeSnapshotVerificationSubmittedV1 | Events::MergeSnapshotVerifiedV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

module Coordinator
  module Write
    module HistoryMigrations
      class DecisionRelationV1Transformer
        def initialize: (
          event_store: EventStore,
          stream_identity_allocator: StreamIdentityAllocator,
          document_transformer: DecisionDocumentTransformer,
          head_reference_resolver: DecisionHeadReferenceResolver,
          partition_identity_mapper: DecisionPartitionIdentityMapper,
          partition_delta_resolver: DecisionPartitionDeltaResolver,
          ?slot_marker_builder: DecisionSlotMarkerBuilder,
          ?schema_registry: LegacyEventSchemaRegistry
        ) -> void

        def call: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_payload: LegacyEvents::DecisionSlotOpenedV1 |
                          Events::DecisionSlotHeadChangedV1 |
                          Events::DecisionPartitionAdvancedV1
        ) -> Dry::Monads::Result
      end
    end
  end
end

module Coordinator
  module Write
    module HistoryMigrations
      module LegacyEvents
        class DecisionSlotV1 < Shared::Value
          def slot_id: () -> String
          def document: () -> Decisions::DecisionSlotDocumentV1
          def compound_marker: () -> Coordinator::Shared::CompoundMarker
        end

        class DecisionActivatedV1 < Events::Base
          def decision_id: () -> String
          def interpretation_id: () -> String
          def recorded_event: () -> EventReference
          def definition_digest: () -> String
          def slot: () -> DecisionSlotV1?
          def partitions: () -> Array[Decisions::DecisionPartitionV1]
          def rationale: () -> Decisions::DecisionActivationRationaleV1
        end

        class DecisionDefinitionCorrectedV1 < Events::Base
          def decision_id: () -> String
          def interpretation_id: () -> String
          def source_message_id: () -> String
          def previous_head: () -> Decisions::DecisionHeadV1
          def definition: () -> Decisions::DecisionDefinitionV1
          def classifier: () -> Interpretations::ClassifierAttributionV1
          def scope_provenance: () -> Interpretations::DecisionScopeProvenanceV1
          def previous_slot: () -> DecisionSlotV1?
          def slot: () -> DecisionSlotV1?
          def previous_partitions: () -> Array[Decisions::DecisionPartitionV1]
          def partitions: () -> Array[Decisions::DecisionPartitionV1]
          def rationale: () -> Decisions::DecisionCorrectionRationaleV1
        end

        class DecisionSlotOpenedV1 < Events::Base
          def slot: () -> DecisionSlotV1
          def opened_by: () -> Decisions::DecisionHeadV1
        end

        class DevelopmentArtifactCapturedV2 < Events::Base
          def artifact: () -> LegacyDevelopmentArtifacts::ArtifactV2
          def captured_at: () -> String
        end

        class DevelopmentArtifactObservedV1 < Events::Base
          def observation: () -> LegacyDevelopmentArtifacts::ArtifactObservationV1
          def recorded_at: () -> String
        end

        class DevelopmentArtifactClassificationCorrectedV1 < Events::Base
          def observation_id: () -> String
          def artifact_id: () -> String
          def classification_revision: () -> Integer
          def title: () -> String
          def kind: () -> String
          def labels: () -> Array[String]
          def reason: () -> String
          def corrected_at: () -> String
        end

        class DevelopmentArtifactRelationDeclaredV1 < Events::Base
          def artifact_relation: () -> LegacyDevelopmentArtifacts::RelationV1
          def declared_at: () -> String
        end

        class DevelopmentArtifactRelationSupersededV1 < Events::Base
          def source_artifact_id: () -> String
          def superseded_relation_id: () -> String
          def replacement_relation_id: () -> String
          def reason: () -> String
          def superseded_at: () -> String
        end

        type coordination_task_lifecycle = CoordinationTaskCancellationRequestedV1 |
          CoordinationTaskCancelledV1 |
          CoordinationTaskCompletedV2 |
          CoordinationTaskExecutionStartedV1 |
          CoordinationTaskFailedV1

        class CommandCompletedV1 < Events::Base
          def command_id: () -> String
          def tool_name: () -> String
          def canonical_input_digest: () -> String
        end

        class CoordinationTaskCancellationRequestedV1 < Events::Base
          def task_id: () -> String
        end

        class CoordinationTaskCancelledV1 < Events::Base
          def task_id: () -> String
          def reason: () -> String
        end

        class CoordinationTaskCompletedV2 < Events::Base
          def task_id: () -> String
          def result: () -> (LegacyTaskResults::value | Tasks::SemanticResultV1::value)
        end

        class CoordinationTaskExecutionStartedV1 < Events::Base
          def task_id: () -> String
        end

        class CoordinationTaskFailedV1 < Events::Base
          def task_id: () -> String
          def error: () -> Tasks::JsonRpcErrorV1
        end

        class CoordinationTaskSubmittedV2 < Events::Base
          def task_id: () -> String
          def tool_name: () -> String
          def command_id: () -> String
          def command_input: () -> (Hash[untyped, untyped] | CommandInputDocuments::value)
          def ttl_ms: () -> nil
          def poll_interval_ms: () -> Integer
        end

        class OperationBatchCancellationRequestedV1 < Events::Base
        end

        class OperationBatchCancelledV1 < Events::Base
        end

        class OperationBatchCompletedV1 < Events::Base
        end

        class OperationBatchContinuationRequestedV1 < Events::Base
        end

        class OperationBatchCreatedV1 < Events::Base
        end

        class OperationBatchItemRejectedV1 < Events::Base
        end

        class OperationBatchItemSucceededV1 < Events::Base
        end
      end
    end
  end
end

module Coordinator
  module Write
    module HistoryMigrations
      class MigrationMetadataV1 < Shared::Value
        def command_id: () -> String
        def actor_kind: () -> String
        def actor_id: () -> String
        def actor_authenticated: () -> bool
        def recorded_by: () -> String
        def policy_version: () -> String
        def migration_id: () -> String
        def migration_source: () -> MigrationSourceV1
        def canonical_input_digest: () -> String?
        def collector: () -> (Candidates::EvidenceCollectorV1 | String)?
        def encoding: () -> String?
        def media_type: () -> String?
        def byte_size: () -> Integer?
        def content_sha256: () -> String?
        def content_digest: () -> String?
        def manifest_digest: () -> String?
        def build_context_digest: () -> String?
        def dependency_graph_digest: () -> String?
        def test_environment_digest: () -> String?
        def analyzer: () -> Candidates::ImpactAnalyzerV1?
        def surface_digest: () -> String?
        def marker_codec_version: () -> String?
        def index_policy_version: () -> String?
        def classifier: () -> Interpretations::ClassifierAttributionV1?
        def scope_provenance: () -> Interpretations::DecisionScopeProvenanceV1?
        def definition_digest: () -> String?
        def context_digest: () -> String?
        def before_context_digest: () -> String?
        def after_context_digest: () -> String?
        def previous_context_digest: () -> String?
        def resulting_context_digest: () -> String?
      end
    end
  end
end

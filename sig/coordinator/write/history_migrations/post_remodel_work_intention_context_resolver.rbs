module Coordinator
  module Write
    module HistoryMigrations
      class PostRemodelWorkIntentionContextResolver
        def initialize: (
          event_store: EventStore,
          stream_identity_allocator: StreamIdentityAllocator,
          entity_reference_resolver: LegacyEntityReferenceResolver,
          ?repository_marker_builder: RepositoryMarkerBuilder,
          ?schema_registry: EventSchemaRegistry
        ) -> void

        def set: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_set_id: String
        ) -> Dry::Monads::Result

        def intention: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_intention_id: String
        ) -> Dry::Monads::Result

        def resource: (
          migration_id: String,
          source_config_name: String,
          source_upper_position: Integer,
          source_event: PgEventstore::Event,
          source_resource_id: String
        ) -> Dry::Monads::Result
      end
    end
  end
end

module Coordinator::Write
  module MergeSnapshots
    class MemberDigestDocumentV1 < Coordinator::Shared::Value
      attr_reader candidate_id: String
      attr_reader change_set_id: String
      attr_reader work_item_id: String
      attr_reader attempt_id: String
      attr_reader base_commit_oid: String
      attr_reader head_commit_oid: String
      attr_reader manifest_digest: String

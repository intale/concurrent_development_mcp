module Coordinator::Write
  module CandidateObligationScans
    class IdentityBuilder
      def initialize: (?canonical_json: Coordinator::Shared::CanonicalJson) -> void
      def registry_sweep: (
        policy_partition_event: Coordinator::Write::EventReference,
        policy_head: Coordinator::Write::Decisions::DecisionHeadV1,
        rule_version: String
      ) -> String
      def pair_scan: (
        source_registration: Coordinator::Write::EventReference,
        direction: String,
        policy_partition_event: Coordinator::Write::EventReference,
        policy_head: Coordinator::Write::Decisions::DecisionHeadV1,
        rule_version: String
      ) -> String
      def progress: (checkpoint_event: Coordinator::Write::EventReference, rule_version: String) -> String
    end
  end
end

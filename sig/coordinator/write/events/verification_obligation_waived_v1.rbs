module Coordinator
  module Write
    module Events
      class VerificationObligationWaivedV1 < Base
        def obligation_id: () -> String
        def obligation_event: () -> EventReference
        def policy: () -> CandidateObligations::ImpactPolicyEvidenceV1
        def previous_status: () -> String
        def previous_terminal_event: () -> EventReference?
        def reason: () -> VerificationObligationWaivers::ReasonV1
        def waiver_input_digest: () -> String
        def waived_at: () -> String
      end
    end
  end
end

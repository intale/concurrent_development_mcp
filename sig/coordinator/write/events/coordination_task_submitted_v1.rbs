module Coordinator
  module Write
    module Events
      class CoordinationTaskSubmittedV1 < Base
        def task_id: () -> String
        def tool_name: () -> String
        def command_id: () -> String
        def canonical_input_digest: () -> String
        def command_input: () -> CommandInputDocuments::value
        def submitted_at: () -> String
        def ttl_ms: () -> nil
        def poll_interval_ms: () -> Integer
      end
    end
  end
end

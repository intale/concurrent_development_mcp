module Coordinator
  module Write
    module Events
      class CandidateSubmittedV1 < Base
        attr_reader candidate_id: String
        attr_reader change_set_id: String
        attr_reader work_item_id: String
        attr_reader attempt_id: String
        attr_reader agent_id: String
        attr_reader repository_id: String
        attr_reader target_branch: String
        attr_reader object_format: String
        attr_reader base_commit_oid: String
        attr_reader head_commit_oid: String
        attr_reader checkpoint_kind: String
        attr_reader lease_set_id: String
        attr_reader lease_policy_version: String
        attr_reader lease_references: Array[Coordinator::Write::LeaseReferenceV1]
        attr_reader manifest_digest: String
        attr_reader build_context_digest: String?
        attr_reader evidence_status: String
        attr_reader submitted_at: String
      end
    end
  end
end

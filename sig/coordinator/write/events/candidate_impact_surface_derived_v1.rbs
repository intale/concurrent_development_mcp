module Coordinator::Write
  module Events
    class CandidateImpactSurfaceDerivedV1 < Base
      def candidate_id: () -> String
      def change_set_id: () -> String
      def work_item_id: () -> String
      def attempt_id: () -> String
      def repository_id: () -> String
      def target_branch: () -> String
      def object_format: () -> String
      def head_commit_oid: () -> String
      def evidence_revision: () -> Integer
      def policy_version: () -> String
      def surface_digest: () -> String
      def manifest_digest: () -> String
      def build_context_digest: () -> String?
      def produces: () -> Array[Coordinator::Write::Candidates::ImpactTransitionV1]
      def consumes: () -> Array[Coordinator::Write::Candidates::ImpactObservationV1]
      def may_affect: () -> Array[Coordinator::Write::Candidates::ImpactKeyV1]
      def assumes: () -> Array[Coordinator::Write::Candidates::ImpactAssumptionV1]
      def analyzer: () -> Coordinator::Write::Candidates::ImpactAnalyzerV1

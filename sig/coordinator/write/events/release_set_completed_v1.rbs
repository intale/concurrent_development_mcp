module Coordinator::Write::Events
  class ReleaseSetCompletedV1 < Base
    Evidence: singleton(Coordinator::Write::ReleaseSets::CompensationEvidenceV1)

    def release_set_id: () -> String
    def change_set_id: () -> String
    def release_digest: () -> String
    def outcome: () -> String
    def source_event: () -> Coordinator::Write::EventReference
    def compensation_evidence: () -> Array[Coordinator::Write::ReleaseSets::CompensationEvidenceV1]
    def completion_digest: () -> String
    def rule_version: () -> String
    def completed_at: () -> String
  end
end

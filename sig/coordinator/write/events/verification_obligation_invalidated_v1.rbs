module Coordinator
  module Write
    module Events
      class VerificationObligationInvalidatedV1 < Base
        def obligation_id: () -> String
        def obligation_event: () -> EventReference
        def invalidated_policy: () -> CandidateObligations::ImpactPolicyEvidenceV1
        def superseding_partition_event: () -> EventReference
        def previous_status: () -> String
        def previous_terminal_event: () -> EventReference?
        def reason: () -> String
        def invalidation_digest: () -> String
        def rule_version: () -> String
        def invalidated_at: () -> String
      end
    end
  end
end

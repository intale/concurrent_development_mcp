module Coordinator
  module Write
    module Events
      class CandidateChangeManifestCapturedV1 < Base
        attr_reader candidate_id: String
        attr_reader repository_id: String
        attr_reader target_branch: String
        attr_reader object_format: String
        attr_reader base_commit_oid: String
        attr_reader head_commit_oid: String
        attr_reader evidence_revision: Integer
        attr_reader policy_version: String
        attr_reader manifest_digest: String
        attr_reader files: Array[Coordinator::Write::Candidates::ManifestFileV1]
        attr_reader collector: Coordinator::Write::Candidates::EvidenceCollectorV1
        attr_reader captured_at: String
      end
    end
  end
end

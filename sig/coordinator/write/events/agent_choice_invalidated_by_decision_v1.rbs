module Coordinator
  module Write
    module Events
      class AgentChoiceInvalidatedByDecisionV1 < Base
        def choice_id: () -> String
        def accepted_choice: () -> EventReference
        def assessment_event: () -> EventReference
        def decision_change_event: () -> EventReference
        def previous_context_digest: () -> String
        def resulting_context_digest: () -> String
        def reason: () -> String
        def invalidated_at: () -> String
      end
    end
  end
end

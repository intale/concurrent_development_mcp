module Coordinator
  module Write
    module Events
      class AgentChoiceImpactScanCompletedV1 < Base
        def scan_id: () -> String
        def started_event: () -> EventReference
        def previous_checkpoint: () -> EventReference
        def previous_from_position: () -> Integer
        def final_from_position: () -> Integer
        def page_count: () -> Integer
        def page_choice_count: () -> Integer
        def total_choice_count: () -> Integer
        def policy_version: () -> String
        def completed_at: () -> String
      end
    end
  end
end

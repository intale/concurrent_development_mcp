module Coordinator
  module Write
    module Events
      class OperationBatchCreatedV1 < Base
        def batch_id: () -> String
        def target_tool: () -> String
        def total: () -> Integer
        def page_size: () -> Integer
        def items: () -> Array[OperationBatches::ItemV1]
        def manifest_digest: () -> String
        def encoded_byte_size: () -> Integer
        def requester: () -> OperationBatches::ActorV1
        def created_at: () -> String
      end
    end
  end
end

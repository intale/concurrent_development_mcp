module Coordinator
  module Write
    module Events
      class DecisionInterpretationProposedV1 < Base
        Ambiguity: singleton(Interpretations::InterpretationAmbiguityV1)

        def interpretation_id: () -> String
        def source_message_id: () -> String
        def source_event: () -> EventReference
        def source_span: () -> Interpretations::SourceSpanV1?
        def classifier: () -> Interpretations::ClassifierAttributionV1
        def proposed_decision: () -> Interpretations::ProposedDecisionV1
        def scope_provenance: () -> Interpretations::DecisionScopeProvenanceV1
        def ambiguities: () -> Array[Interpretations::InterpretationAmbiguityV1]
        def assessment: () -> Interpretations::InterpretationAssessmentV1
        def proposed_at: () -> String
      end
    end
  end
end

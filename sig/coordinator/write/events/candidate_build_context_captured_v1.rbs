module Coordinator
  module Write
    module Events
      class CandidateBuildContextCapturedV1 < Base
        attr_reader candidate_id: String
        attr_reader repository_id: String
        attr_reader object_format: String
        attr_reader head_commit_oid: String
        attr_reader evidence_revision: Integer
        attr_reader policy_version: String
        attr_reader build_context_digest: String
        attr_reader inputs: Array[Coordinator::Write::Candidates::BuildInputV1]
        attr_reader environment: Array[Coordinator::Write::Candidates::EnvironmentEntryV1]
        attr_reader dependency_graph_digest: String?
        attr_reader test_environment_digest: String?
        attr_reader collector: Coordinator::Write::Candidates::EvidenceCollectorV1
        attr_reader captured_at: String
      end
    end
  end
end

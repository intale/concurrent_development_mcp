module Coordinator
  module Write
    module Events
      class DecisionRecordedV1 < Base
        def decision_id: () -> String
        def interpretation_id: () -> String
        def source_message_id: () -> String
        def source_event: () -> EventReference
        def proposal_event: () -> EventReference
        def acceptance_event: () -> EventReference
        def definition: () -> Decisions::DecisionDefinitionV1
        def classifier: () -> Interpretations::ClassifierAttributionV1
        def scope_provenance: () -> Interpretations::DecisionScopeProvenanceV1
        def recorded_at: () -> String
      end
    end
  end
end

module Coordinator
  module Write
    module Events
      class ResourceBoundaryEpochRolledV2 < Base
        class ActiveLeaseV2 < Shared::Value
          def self.from_state: (Domain::ResourceLeases::State state) -> ActiveLeaseV2
          def to_state: () -> Domain::ResourceLeases::State
          def lease_id: () -> String
          def lease_set_id: () -> String
          def resource_id: () -> String
          def resource_kind: () -> String
          def resource_path: () -> String
          def policy_version: () -> String
          def mode: () -> String
          def change_set_id: () -> String
          def work_item_id: () -> String
          def attempt_id: () -> String
          def agent_id: () -> String
          def repository_id: () -> String
          def object_format: () -> String
          def base_commit_oid: () -> String
          def base_blob_oid: () -> String?
          def fencing_token: () -> Integer
          def acquired_at: () -> String
          def renewed_at: () -> String?
          def expires_at: () -> String
        end

        ActiveLease: untyped

        def repository_id: () -> String
        def boundary_marker: () -> String
        def epoch: () -> Integer
        def previous_through_global_position: () -> Integer?
        def through_global_position: () -> Integer
        def active_leases: () -> Array[ActiveLeaseV2]
        def rolled_at: () -> String
      end
    end
  end
end

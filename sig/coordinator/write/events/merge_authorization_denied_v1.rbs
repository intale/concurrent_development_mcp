module Coordinator
  module Write
    module Events
      class MergeAuthorizationDeniedV1 < Base
        def authorization_id: () -> String
        def merge_snapshot_id: () -> String
        def policy_version: () -> String
        def snapshot_binding: () -> MergeAuthorizations::SnapshotBindingV1
        def expected_impact_policy: () -> MergeAuthorizations::ExpectedImpactPolicyV1?
        def evaluation: () -> MergeAuthorizations::EvaluationV1
        def input_digest: () -> String
        def decision_digest: () -> String
        def decided_at: () -> String
      end
    end
  end
end

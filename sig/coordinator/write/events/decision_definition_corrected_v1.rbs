module Coordinator
  module Write
    module Events
      class DecisionDefinitionCorrectedV1 < Base
        Partition: singleton(Decisions::DecisionPartitionV1)

        def decision_id: () -> String
        def interpretation_id: () -> String
        def source_message_id: () -> String
        def source_event: () -> EventReference
        def proposal_event: () -> EventReference
        def acceptance_event: () -> EventReference
        def previous_head: () -> Decisions::DecisionHeadV1
        def previous_definition_digest: () -> String
        def definition: () -> Decisions::DecisionDefinitionV1
        def classifier: () -> Interpretations::ClassifierAttributionV1
        def scope_provenance: () -> Interpretations::DecisionScopeProvenanceV1
        def previous_slot: () -> Decisions::DecisionSlotV1?
        def slot: () -> Decisions::DecisionSlotV1?
        def previous_partitions: () -> Array[Decisions::DecisionPartitionV1]
        def partitions: () -> Array[Decisions::DecisionPartitionV1]
        def rationale: () -> Decisions::DecisionCorrectionRationaleV1
        def corrected_at: () -> String
      end
    end
  end
end

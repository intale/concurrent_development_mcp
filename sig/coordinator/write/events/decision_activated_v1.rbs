module Coordinator
  module Write
    module Events
      class DecisionActivatedV1 < Base
        def decision_id: () -> String
        def interpretation_id: () -> String
        def recorded_event: () -> EventReference
        def definition_digest: () -> String
        def slot: () -> Decisions::DecisionSlotV1?
        def partitions: () -> Array[Decisions::DecisionPartitionV1]
        def rationale: () -> Decisions::DecisionActivationRationaleV1
        def activated_at: () -> String
      end
    end
  end
end

module Coordinator
  module Write
    module Events
      class VerificationObligationSatisfiedV1 < Base
        Evidence: untyped

        def obligation_id: () -> String
        def obligation_event: () -> EventReference
        def policy: () -> CandidateObligations::ImpactPolicyEvidenceV1
        def selected_evidence: () -> Array[CompatibilityAssessments::EvidenceDecisionReferenceV1]
        def outcome_digest: () -> String
        def satisfied_at: () -> String
      end
    end
  end
end

module Coordinator
  module Write
    class RepositoryMarkerBuilder
      def initialize: (
        ?compound_marker_builder: Shared::CompoundMarkerBuilder,
        ?resource_marker_codec: Shared::ResourceMarkerCodec
      ) -> void
      def call: (Events::RepositoryRegisteredV1 registration) -> Array[String]
      def resource_event_markers: (repository_id: String, resource_kind: String, resource_path: String) -> Array[String]
      def resource_boundary_markers: (repository_id: String, resource_kind: String, resource_path: String) -> Array[String]
    end
  end
end

module Coordinator::Write::ChangeSetCompletions
  class SourceEvidenceV1 < Coordinator::Shared::Value
    type payload = Coordinator::Write::Events::WorkItemCompletedV2 |
                   Coordinator::Write::Events::ReleaseSetCompletedV2


module Coordinator::Web::Graphql
  class KnowledgeBrowserCursor
    PREFIX: String

    def self.encode_skills: (repository_id: String, after_id: String, skill_name: String?) -> String
    def self.decode_skills: (String? cursor, repository_id: String, skill_name: String?) -> String?
    def self.encode_artifacts: (
      repository_id: String,
      after_position: Integer,
      artifact_kind: String?,
      labels: Array[String],
      source_kind: String?
    ) -> String
    def self.decode_artifacts: (
      String? cursor,
      repository_id: String,
      artifact_kind: String?,
      labels: Array[String],
      source_kind: String?
    ) -> Integer?
    def self.encode_relations: (
      repository_id: String,
      artifact_id: String,
      direction: String,
      relation: String?,
      cursor: Coordinator::Read::DevelopmentArtifactRelationPageV1::Cursor
    ) -> String
    def self.decode_relations: (
      String? cursor,
      repository_id: String,
      artifact_id: String,
      direction: String,
      relation: String?
    ) -> Hash[Symbol, untyped]?

    private

    def self.encode: (Hash[String, untyped] payload) -> String
    def self.decode: (String cursor, String kind) -> Hash[String, untyped]
    def self.valid_kind_payload?: (Hash[String, untyped] payload, String kind) -> bool
    def self.valid_relation_payload?: (Hash[String, untyped] payload) -> bool
  end
end

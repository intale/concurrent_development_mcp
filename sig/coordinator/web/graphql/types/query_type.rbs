module Coordinator::Web::Graphql::Types
  class QueryType < BaseObject
    def projects: (scope: String, first: Integer, ?after: String?) -> Hash[Symbol, untyped]
    def project_coordination: (
      repository_id: String,
      first: Integer,
      work_item_sort: String,
      ?blocking: bool?,
      ?change_sets_after: String?,
      ?dependencies_after: String?,
      ?presentation_statuses: Array[String]?,
      ?work_items_after: String?
    ) -> Hash[Symbol, untyped]?
    def project_resources: (
      repository_id: String,
      first: Integer,
      ?active_leases_after: String?,
      ?resource_kind: String?,
      ?resource_lifecycle_status: String?,
      ?resources_after: String?
    ) -> Hash[Symbol, untyped]?
    def project_knowledge: (
      repository_id: String,
      first: Integer,
      ?artifact_kind: String?,
      ?artifact_labels: Array[String]?,
      ?artifact_source_kind: String?,
      ?artifacts_after: String?,
      ?skill_name: String?,
      ?skills_after: String?
    ) -> Hash[Symbol, untyped]?
    def project_skill: (repository_id: String, name: String) -> Coordinator::Read::Web::KnowledgeBrowserV1::SkillDetail?
    def project_skill_asset: (
      repository_id: String,
      name: String,
      path: String
    ) -> Coordinator::Read::Web::KnowledgeBrowserV1::SkillAssetDetail?
    def project_artifact: (
      repository_id: String,
      artifact_id: String,
      first: Integer,
      direction: String,
      ?relation: String?,
      ?relations_after: String?
    ) -> Hash[Symbol, untyped]?

    private

    def connection: (untyped page, String kind) -> Hash[Symbol, untyped]
    def resource_connection: (
      untyped page,
      repository_id: String,
      resource_kind: String?,
      lifecycle_status: String?
    ) -> Hash[Symbol, untyped]
    def active_lease_connection: (
      untyped page,
      repository_id: String,
      as_of: String
    ) -> Hash[Symbol, untyped]
    def skill_connection: (untyped page, repository_id: String, skill_name: String?) -> Hash[Symbol, untyped]
    def artifact_connection: (
      untyped page,
      repository_id: String,
      artifact_kind: String?,
      labels: Array[String],
      source_kind: String?
    ) -> Hash[Symbol, untyped]
    def artifact_relation_connection: (
      untyped page,
      repository_id: String,
      artifact_id: String,
      direction: String,
      relation: String?
    ) -> Hash[Symbol, untyped]
    def knowledge_browser: () -> Coordinator::Read::Web::Queries::KnowledgeBrowser
    def raise_knowledge_query_error: (Coordinator::Read::Web::KnowledgeBrowserQueryError error) -> bot
    def raise_query_error: (Coordinator::Read::QueryResultV1 result) -> bot
  end
end

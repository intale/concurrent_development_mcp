module Coordinator
  module Shared
    module Observability
      interface _EventHandler[Result]
        def call: (PgEventstore::Event event) -> Result
      end

      class SubscriptionHandler[Result]
        attr_reader definition: _SubscriptionDescriptor

        def initialize: (definition: _SubscriptionDescriptor, handler: _EventHandler[Result]) -> void
        def call: (PgEventstore::Event event) -> Result

        private
        def observe: (Session session, Hash[String, String] attributes, PgEventstore::Event event) -> void
        def outcome: [T] (T result) -> String
      end
    end
  end
end

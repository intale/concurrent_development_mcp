module Coordinator
  module Processes
    module VerificationObligationValidity
      class CommandBuilder
        ACTOR: Write::Commands::Actor
        RULE_VERSION: String
        PAGE_SIZE: Integer
        def initialize: (
          event_store: Write::_EventStore,
          ?process_step_planner: Coordinator::Processes::ProcessStepPlanner
        ) -> void
        def start: (SourceV1 source) -> Write::VerificationObligationValidityScanInvocation
        def progress: (checkpoint: ScanCheckpointV1, page: PageV1) -> Write::VerificationObligationValidityScanProgressInvocation
        def invalidation: (
          obligation_event: PgEventstore::Event,
          superseding_partition_event: Write::EventReference,
          caused_by_event: PgEventstore::Event,
          caused_by_reference: Write::EventReference
        ) -> Write::VerificationObligationInvalidationInvocation
      end
    end
  end
end

module Coordinator
  module Processes
    class LeaseExpirySource < Shared::Value
      type payload = Write::Events::ResourceWorkIntentionDeclaredV1 | Write::Events::ResourceWorkIntentionRenewedV1

      def event: () -> PgEventstore::Event
      def reference: () -> Write::EventReference
      def payload: () -> payload
      def state: () -> Write::Domain::WorkIntentions::State?
    end
  end
end

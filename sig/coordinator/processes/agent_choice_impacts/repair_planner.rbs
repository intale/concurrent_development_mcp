          event_store: Write::_EventStore,
          ?choice_loader: Write::AgentChoiceImpacts::ChoiceLoader,
          ?partition_loader: PartitionSnapshotLoader,
          ?source_builder: SourceBuilder,
          ?decision_change_builder: Write::AgentChoiceImpacts::DecisionChangeEvidenceBuilder,

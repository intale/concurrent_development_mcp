module Coordinator
  module Processes
    module OperationBatches
      class CommandBuilder
        SYSTEM_ACTOR: Write::Commands::Actor

        def record_outcome: (source: SourceV1, item: Write::OperationBatches::ItemV1, result: Write::Tasks::ToolResultV1, completion: TargetCompletionV1?) -> Write::Commands::RecordOperationBatchItemOutcome
        def continuation: (source: SourceV1, page_start: Integer, page_end: Integer) -> Write::Commands::RequestOperationBatchContinuation
        def complete: (source: SourceV1) -> Write::Commands::CompleteOperationBatch
        def complete_cancellation: (source: SourceV1) -> Write::Commands::CompleteOperationBatchCancellation
      end
    end
  end
end

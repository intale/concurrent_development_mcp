module Coordinator
  module Mcp
    module UsageSkills
      class Installer
        REVISION_ATTEMPTS: Integer
        ACTOR: Hash[Symbol, String]
        def initialize: (
          server: Tasks::Server,
          ?definitions: Array[Definition],
          ?release: Integer,
          ?run_id: String,
          ?output: IO | StringIO,
          ?timeout_seconds: Numeric
        ) -> void
        def call: () -> Array[InstallationResult]

        private

        def install: (Definition definition) -> InstallationResult
        def observed_revision: (Definition definition) -> Integer
        def publication_outcome: (Hash[String, untyped] payload) -> String
        def await_task: (String task_id) -> Hash[String, untyped]
        def invoke: (String name, Hash[Symbol, untyped] arguments) -> Hash[String, untyped]
      end
    end
  end
end

module Coordinator
  module Mcp
    module Tasks
      class Extension
        CAPABILITIES: Hash[String, Hash[untyped, untyped]]
        GET_METHOD: String
        UPDATE_METHOD: String
        CANCEL_METHOD: String

        def self.negotiated?: (::MCP::ServerContext? server_context) -> bool
        def initialize: (lifecycle: Lifecycle) -> void

        def register: (::MCP::Server server) -> ::MCP::Server
      end
    end
  end
end

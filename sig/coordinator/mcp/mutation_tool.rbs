module Coordinator
  module Mcp
    class MutationTool < Tool
      def self.to_h: () -> Hash[Symbol, untyped]
      def self.output_schema: () -> ::MCP::Tool::OutputSchema
                            | (Hash[Symbol, untyped] value) -> untyped
      def self.operation: () -> String
                        | (String key) -> String
      def self.call: (?server_context: ::MCP::ServerContext?, **untyped arguments) -> Tasks::ResultV1::Created
    end
  end
end
